#!/usr/bin/env bb
;; legu — human review coverage for a codebase.
;; Depends on babashka 1.13.220 or newer and git. Nothing else.

(ns legu.main
  (:require [babashka.cli :as cli]
            [babashka.fs :as fs]
            [babashka.process :as p]
            [cheshire.core :as json]
            [clojure.set :as set]
            [clojure.string :as str])
  (:import [java.nio.file FileAlreadyExistsException]
           [java.security KeyFactory KeyPairGenerator MessageDigest Signature]
           [java.security.spec PKCS8EncodedKeySpec X509EncodedKeySpec]
           [java.time Instant]
           [java.time.temporal ChronoUnit]
           [java.util Arrays Base64 HexFormat]))

(def ^:dynamic *root* ".")
(def ^:dynamic *git?* true)

(def NUL #"\u0000")

;; What `git log --format` prints ahead of each commit's file list. Any byte
;; git will not emit inside a path would do. git refuses the raw byte in a
;; format string, so the format spells it as an escape derived from this one
;; rather than as a second literal that could drift from it.
(def SENTINEL "\u0001")
(def SENTINEL-FORMAT (format "--format=%%x%02x" (int (first SENTINEL))))

;; Files are decoded as latin-1 so every byte round-trips: a change in a
;; non-UTF-8 byte must not be invisible to the content hash.
(def ENC "ISO-8859-1")

(def VERSION "0.5.0")

;; legu is moving its argument parsing onto the babashka.cli bundled with
;; babashka, whose option spec and generated help arrived in this release. The
;; floor lands ahead of that move so a reader on an older babashka meets this
;; message rather than a resolution error naming a library they never chose to
;; depend on.
(def MIN-BABASHKA "1.13.220")

(defn die [msg]
  (binding [*out* *err*] (println (str "legu: " msg)))
  (System/exit 1))

(defn- version-numbers
  "The dotted components of a version string as longs, or nil when any of them
   is not a number."
  [v]
  (let [parts (map parse-long (str/split (str v) #"\."))]
    (when (every? some? parts) (vec parts))))

(defn babashka-too-old
  "The message for a babashka older than floor, or nil when it is new enough.
   Components are compared as numbers, so 1.13.9 is older than 1.13.220. A
   version string that does not split into numbers, such as a dev build, counts
   as new enough: refusing to run on a version legu cannot read would cost more
   than the check saves."
  [running floor]
  (let [found (version-numbers running)
        want (version-numbers floor)]
    (when (and found want)
      (let [width (max (count found) (count want))
            pad #(vec (take width (concat % (repeat 0))))]
        (when (neg? (compare (pad found) (pad want)))
          (str "needs babashka " floor " or newer, but found " running
               "; install a newer babashka from https://babashka.org"))))))

;; ---------------------------------------------------------------- git

(defn git
  "Run git in the repo root. Returns {:exit :out :err}; never throws."
  [& args]
  (apply p/sh {:dir *root* :out :string :err :string :continue true} "git" args))

(defn git-ok
  "stdout of a successful git invocation, or nil."
  [& args]
  (let [{:keys [exit out]} (apply git args)]
    (when (zero? exit) out)))

(defn git-toplevel []
  (let [{:keys [exit out]} (p/sh {:out :string :err :string :continue true}
                                 "git" "rev-parse" "--show-toplevel")]
    (when (zero? exit) (not-empty (str/trim out)))))

(defn head-sha []
  (some-> (git-ok "rev-parse" "HEAD") str/trim))

(defn split-z [s]
  (when s (vec (remove str/blank? (str/split s NUL)))))

(defn tracked-files []
  (or (split-z (git-ok "ls-files" "-z")) []))

(def ^:private tracked-cache (atom nil))

(defn tracked-set
  "Tracked paths as a set, asked of git once per run."
  []
  (or @tracked-cache (reset! tracked-cache (set (tracked-files)))))

(defn ignored-files
  "Tracked files matching the store's ignore list, .review/ignore (ADR-0017).
   Gitignore syntax, matched by git itself."
  []
  (let [f (fs/file *root* ".review" "ignore")]
    (cond
      (not (fs/exists? f)) #{}

      (not *git?*)
      (do (binding [*out* *err*]
            (println "legu: .review/ignore needs git to match; every file counts as eligible"))
          #{})

      :else
      (let [{:keys [exit out err]} (git "ls-files" "-c" "-i" "-z"
                                        (str "--exclude-from=" f))]
        (when-not (zero? exit)
          (die (str "cannot apply .review/ignore: " (str/trim (or err "")))))
        (set (split-z out))))))

(defn- name-status
  "Parsed `git diff --name-status -z` between commit and the working tree. Low
   similarity thresholds, so a small file renamed *and* edited is still matched."
  [commit]
  (loop [toks (or (split-z (git-ok "diff" "-M20%" "--name-status" "-z" commit)) [])
         renames {} added []]
    (if-let [t (first toks)]
      (cond
        (re-matches #"^R\d*$" t)
        (recur (drop 3 toks) (assoc renames (second toks) (nth toks 2 nil)) added)

        (re-matches #"^C\d*$" t)
        (recur (drop 3 toks) renames (conj added (nth toks 2 nil)))

        (re-matches #"^A\d*$" t)
        (recur (drop 2 toks) renames (conj added (second toks)))

        (re-matches #"^[A-Z]\d*$" t)
        (recur (drop 2 toks) renames added)

        :else (recur (rest toks) renames added))
      {:renames renames :added added})))

(def ^:private diff-cache (atom {}))

(defn diff-summary [commit]
  (or (get @diff-cache commit)
      (let [c (name-status commit)]
        (swap! diff-cache assoc commit c)
        c)))

(defn commit-file-sets
  "The paths changed by each commit that changed more than one, one set per
   commit, from one `git log` over the whole history. A commit touching a
   single file says nothing about what changes together, and a merge lists
   nothing at all — which is what we want, since a merge would otherwise read
   as every file on the branch changing together."
  []
  (->> (str/split (or (git-ok "log" "--name-only" "-z" SENTINEL-FORMAT) "") NUL)
       ;; A commit's own token is the sentinel; the newline git puts between it
       ;; and the first path rides on whichever token comes next.
       (reduce (fn [acc t]
                 (let [t (str/replace-first t #"^\n" "")]
                   (cond
                     (str/starts-with? t SENTINEL) (conj acc #{})
                     (str/blank? t) acc
                     (empty? acc) acc
                     :else (update acc (dec (count acc)) conj t))))
               [])
       (filterv #(> (count %) 1))))

;; ---------------------------------------------------------------- content

(defn- hex [^bytes bs]
  (.formatHex (HexFormat/of) bs))

(defn sha256 [^String s]
  (hex (.digest (MessageDigest/getInstance "SHA-256") (.getBytes s ENC))))

(defn sha256-bytes [^bytes bs]
  (hex (.digest (MessageDigest/getInstance "SHA-256") bs)))

(defn binary-bytes? [^bytes bs]
  ;; latin-1 gives each byte its own char, so String.indexOf finds the NUL
  ;; inside the JVM. An interpreted loop over the bytes was the largest cost of
  ;; coverage: docs/experiments/mark-and-coverage-latency.md.
  (let [n (min (alength bs) 8000)]
    (not= -1 (.indexOf (String. bs 0 n ENC) "\u0000"))))

(defn lines-of [^String s]
  (if (= "" s)
    []
    (let [v (vec (.split s "\n" -1))
          v (if (= "" (peek v)) (pop v) v)]
      ;; String.split on a one-character string skips the regex engine. The
      ;; CR regex stays: java.util.regex.Pattern's $ also matches ahead of a
      ;; final line terminator, which in latin-1 text means a CR or a NEL, so
      ;; a line ending in CR NEL loses its CR and stored content hashes depend
      ;; on that. Only a line holding a CR pays for the regex.
      (mapv (fn [^String l] (if (str/includes? l "\r") (str/replace l #"\r$" "") l)) v))))

(defn norm-hash
  "Hash of a line sequence, leading and trailing whitespace stripped per line."
  [lines]
  (sha256 (str/join "\n" (map str/trim lines))))

(defn- indent-of
  "The run of whitespace a line opens with."
  [^String l]
  (re-find #"^\s*" l))

(defn- common-prefix [^String a ^String b]
  (subs a 0 (count (take-while true? (map = a b)))))

(defn- dedented
  "`lines` with the leading whitespace common to every line of them taken off
   and the end of each line trimmed. A blank line shares no indentation, so it
   neither narrows the common run nor keeps one of its own."
  [lines]
  (let [held (remove str/blank? lines)
        indent (if (seq held) (reduce common-prefix (map indent-of held)) "")
        n (count indent)]
    (mapv (fn [^String l] (if (str/blank? l) "" (str/trimr (subs l n)))) lines)))

(defn same-read?
  "ADR-0019: two texts are the same read when, after removing the leading
   whitespace common to every line of each, they trim equal at the end of each
   line. Trailing whitespace never matters and leading whitespace matters
   relative to the region, so a block reindented together reads the same and a
   line moved to another level does not."
  [old-lines new-lines]
  (and (= (count old-lines) (count new-lines))
       (= (dedented old-lines) (dedented new-lines))))

(defn- read-worktree-file
  "{:kind :text|:binary|:missing|:unreadable, :text, :lines, :line-count, :hash}.
   :lines is a delay: only anchoring a file that changed since review looks
   at its lines, so a file that did not never pays to split them."
  [path]
  (let [f (fs/file *root* path)]
    (if-not (fs/regular-file? f)
      {:kind :missing}
      (try
        (let [bs (fs/read-all-bytes f)
              h (sha256-bytes bs)]
          (if (binary-bytes? bs)
            {:kind :binary :hash h}
            (let [s (String. bs ENC)]
              {:kind :text :text s :hash h
               :line-count (count (lines-of s))
               :lines (delay (lines-of s))})))
        (catch java.io.IOException _ {:kind :unreadable})))))

(def ^:private worktree-cache (atom {}))

(defn read-worktree
  "The working-tree file at `path`, read once per run: legu never writes a
   source file, so a second read would find what the first did. Holding a
   vector of every line of every file took a whole-store read past half a
   gigabyte, which is why :lines stays unsplit until something forces it."
  [path]
  (or (get @worktree-cache path)
      (let [c (read-worktree-file path)]
        (swap! worktree-cache assoc path c)
        c)))

;; [commit path] -> the file's text at that commit, for every pair legu has
;; asked git about. An absent object is cached as nil, so a lookup tells a
;; pair nobody asked for from one git has no object for.
(def ^:private blob-cache (atom {}))

(defn- parse-batch
  "The texts `git cat-file --batch` answered with, in the order they were
   asked for. Each object arrives as a header line, exactly as many bytes as
   the header announces, and a newline; an object git does not have is a
   header line on its own. `out` is decoded latin-1, so a byte is a character
   and the announced length indexes the string. The type and the length are
   matched at the end of the header: a missing object's header echoes the
   request, and a path may hold spaces."
  [out]
  (loop [i 0 acc []]
    (if (>= i (count out))
      acc
      (let [nl (or (str/index-of out "\n" i) (count out))
            [_ kind size] (re-find #" (blob|tree|commit|tag) (\d+)$" (subs out i nl))]
        (if size
          (let [from (inc nl)
                to (min (count out) (+ from (parse-long size)))]
            (recur (inc to) (conj acc (when (= "blob" kind) (subs out from to)))))
          (recur (inc nl) (conj acc nil)))))))

(defn- read-blobs
  "The text of each [commit path] pair at its commit, from one git process,
   nil where git has no such object. Read as bytes and decoded latin-1 like
   every other file legu reads, so a byte that is not UTF-8 round-trips."
  [pairs]
  (let [{:keys [exit out]}
        (p/sh {:dir *root* :out :bytes :err :string :continue true
               :in (str/join (for [[commit path] pairs] (str commit ":" path "\n")))}
              "git" "cat-file" "--batch")
        texts (if (zero? exit) (parse-batch (String. ^bytes out ENC)) [])]
    (take (count pairs) (concat texts (repeat nil)))))

(defn- needs-blob?
  "Will anchoring `record` want its file as it was at the commit it cites?
   Whenever the file changed since the review: the old text is what a rename
   or an added-file candidate is diffed against, and what vetoes a moved block
   that already had a twin. Unlike `needs-hunks?` this asks nothing of the
   path, which may be gone from the working tree and from git's index and
   still be the path the old text lives at."
  [{:keys [path commit opaque file-hash]}]
  (and *git?*
       (not opaque)
       (not= file-hash (:hash (read-worktree path)))
       (re-matches #"[0-9a-f]{7,64}" (str commit))))

(defn- uncached-pairs
  "The distinct [commit path] pairs of `records` that `want?` asks for and
   `cache` does not hold yet."
  [records want? cache]
  (->> records
       (filter want?)
       (map (juxt :commit :path))
       distinct
       (remove #(contains? @cache %))))

(defn fetch-blobs!
  "Read the file each of `records` cites at the commit it cites, all in one
   `git cat-file --batch`, so that no record spawns a process of its own. The
   requests go over stdin, which no command-line limit applies to."
  [records]
  (let [pairs (vec (uncached-pairs records needs-blob? blob-cache))]
    (when (seq pairs)
      (swap! blob-cache into (map vector pairs (read-blobs pairs))))))

(defn read-at-commit
  "The text of `path` at `commit`, read once per pair per run. A pair no
   `fetch-blobs!` asked for pays for a batch of its own rather than going
   without, so a caller's answer never depends on having been prefetched."
  [commit path]
  (when *git?*
    (let [k [commit path]]
      (when-not (contains? @blob-cache k)
        (swap! blob-cache assoc k (first (read-blobs [k]))))
      (get @blob-cache k))))

;; ---------------------------------------------------------------- store

(defn store-path
  "Where `path`'s sidecar lives, relative to the repo root (ADR-0017)."
  [path]
  (str ".review/sidecars/" path ".jsonl"))

(defn in-store?
  "Whether the repo-relative `path` is one of legu's own files under .review/."
  [path]
  (str/starts-with? path ".review/"))

(defn store-file [path]
  (fs/file *root* (store-path path)))

(def signers-path
  "The signers list, relative to the repo root (ADR-0016, ADR-0017). Its
   presence is what makes the store signed."
  ".review/signers")

(defn signers-file []
  (fs/file *root* signers-path))

(defn- signers-text
  "The signers list's text. Dies when the file is there but cannot be read."
  []
  (try (slurp (signers-file))
       (catch Exception e (die (str "cannot read " signers-path ": " (ex-message e))))))

(defn- signers-entries
  "Every line of a signers list's text but blank lines and lines starting
   with #, in file order, as {:line :text} with its 1-based line number. A
   line with a binding's shape, the key, one space, then the name to end of
   line, also carries :public-key and :reviewer."
  [text]
  (keep-indexed
   (fn [i line]
     (when-not (or (str/blank? line) (str/starts-with? line "#"))
       (let [[_ public-key reviewer] (re-matches #"(\S+) (.+)" line)]
         (cond-> {:line (inc i) :text line}
           public-key (assoc :public-key public-key :reviewer reviewer)))))
   (str/split-lines text)))

(defn- parse-signers
  "The bindings in a signers list's text, in file order, as
   {:public-key :reviewer}. A line of any other shape is skipped; verify
   reports it."
  [text]
  (for [entry (signers-entries text) :when (:public-key entry)]
    (select-keys entry [:public-key :reviewer])))

(defn- binding-of
  "The binding for `public-key` in a signers list's text, or nil."
  [text public-key]
  (first (filter #(= public-key (:public-key %)) (parse-signers text))))

;; Sidecars are committed alongside the code, so a merge conflict in one is
;; expected. Reading collects them here and answers for every other file;
;; writing still refuses, because a write over a sidecar legu cannot parse
;; would drop the state it holds.
(def ^:private store-errors (atom (sorted-map)))

(def ^:private sidecar-schema 4)

(defn- parse-line
  "The one JSON value on a sidecar line, or ::broken with the reason. Read
   as a sequence rather than with parse-string, which stops at the end of
   the first value and would pass a line with anything after it."
  [line]
  (try (let [values (doall (json/parsed-seq (java.io.StringReader. line) true))]
         (if (= 1 (count values))
           (first values)
           [::broken (if (empty? values) "blank line" "more than one value on the line")]))
       (catch Exception e
         ;; Jackson's message goes on to name the source and the column,
         ;; which a reader of stderr does not need.
         [::broken (first (str/split-lines (or (ex-message e) "not JSON")))])))

(defn- broken? [v]
  (and (vector? v) (= ::broken (first v))))

(defn- sidecar-lines
  "The lines of a sidecar's text. Only the newline that ends the file is not
   a line of its own: a blank line anywhere else reaches `parse-line` and is
   refused there, where `split-lines` would have dropped it from the tail."
  [^String text]
  (let [v (vec (.split text "\n" -1))]
    (if (= "" (peek v)) (pop v) v)))

(defn- bad-range
  "Why a record's line range is not one, or nil when it is."
  [r]
  (when-not (or (:opaque r)
                (and (int? (:start r)) (int? (:end r))
                     (pos? (:start r)) (<= (:start r) (:end r))))
    (str "bad line range in " (pr-str r))))

(defn- parse-sidecar-file
  "{:state s} for the sidecar of `path` when legu can read it, {:error reason}
   when it cannot. The layout is ADR-0015's: a header line, then one record
   per line, a review record when it has a reviewer and a ticket reference
   when it has a ticket. One line that does not parse makes the whole sidecar
   unreadable rather than a line to skip, since the lines a merge conflict
   wraps are records too and a write over them would lose them. There are no
   stores outside this repository, so an older schema is refused rather than
   migrated."
  [path]
  (let [[lines unreadable] (try [(sidecar-lines (slurp (store-file path))) nil]
                                (catch Exception e [nil (ex-message e)]))
        [header & records] (map parse-line lines)
        review? #(contains? % :reviewer)
        record? (fn [r] (and (map? r) (or (review? r) (contains? r :ticket))))
        broken-line (first (keep-indexed (fn [i r] (when (broken? r) (str "line " (+ i 2) ": " (second r))))
                                         records))
        range-error (some bad-range records)]
    (cond
      unreadable {:error unreadable}
      (broken? header) {:error (second header)}
      (not (map? header)) {:error "not a review record"}
      (not= sidecar-schema (:schema header))
      {:error (str "schema " (pr-str (:schema header))
                   " is not the schema legu writes (" sidecar-schema ")")}
      broken-line {:error broken-line}
      (not (every? record? records)) {:error "not a review record"}
      range-error {:error range-error}
      :else {:state {:path path
                     :regions (vec (filter review? records))
                     :tickets (vec (remove review? records))}})))

(def ^:private sidecar-cache (atom {}))
(def ^:private stored-cache (atom nil))

(defn- parse-sidecar
  "The parse of `path`'s sidecar, kept until `save-state!` writes it. Every
   command still parses every sidecar, for `emit` to name the ones it cannot
   read, but no sidecar twice."
  [path]
  (or (get @sidecar-cache path)
      (let [r (parse-sidecar-file path)]
        (swap! sidecar-cache assoc path r)
        r)))

(defn- blank-state [path]
  {:path path :regions [] :tickets []})

(defn load-state
  "The sidecar of `path`, dying when it cannot be read. For writers."
  [path]
  (if (fs/exists? (store-file path))
    (let [{:keys [state error]} (parse-sidecar path)]
      (or state (die (str "cannot read " (store-file path) ": " error))))
    (blank-state path)))

(defn read-state
  "The sidecar of `path`, or nil when it cannot be read — recorded under
   `store-errors` for `emit` to report. Never hand a nil to `save-state!`:
   it would remove the sidecar and the state that is still in it."
  [path]
  (if (fs/exists? (store-file path))
    (let [{:keys [state error]} (parse-sidecar path)]
      (or state (do (swap! store-errors assoc path error) nil)))
    (blank-state path)))

(defn assert-readable!
  "Die unless `path`'s sidecar can be read. A write runs this before it
   touches anything: one that cannot land must change nothing."
  [path]
  (load-state path)
  nil)

;; A record is one line, so that git shows a mark, a supersede or a forget as
;; one changed line and nothing else. The line is rendered by hand rather
;; than by cheshire so the keys keep this order: what a human scans, the
;; region and who and when, sits in the first sixty columns and the hashes
;; are a tail the eye skips. Records are sorted on every field they hold, in
;; this same order, so the same state is the same bytes whatever order it was
;; reached in. A signed review record's signature is the last key, after the
;; hashes, and so also the last tie-breaker (ADR-0016). This is the only list
;; of keys: a key missing from it is dropped by every rewrite.
(def ^:private record-keys
  [:opaque :start :end :reviewer :ticket :timestamp :commit :file-hash :content-hash
   :signature])

(defn- render-record [record]
  (let [record (if (:opaque record)
                 (dissoc record :start :end :content-hash)
                 (dissoc record :opaque))]
    (str "{"
         (str/join "," (for [k record-keys :when (contains? record k)]
                         (str (json/generate-string (name k)) ":"
                              (json/generate-string (get record k)))))
         "}")))

(defn- signed-bytes
  "The bytes a review record's signature covers (ADR-0016): the line
   legu-review-record, a newline, then the record's line as `render-record`
   writes it, without the signature key and without a trailing newline."
  [record]
  (.getBytes (str "legu-review-record\n" (render-record (dissoc record :signature))) "UTF-8"))

(defn- record-order [record]
  (into [(or (:start record) 0) (or (:end record) 0)]
        (for [k record-keys] (str (get record k)))))

(defn- render-sidecar
  "Render the header line, every review record sorted by region, then every
   ticket reference sorted the same way."
  [{:keys [regions tickets]}]
  (str (json/generate-string {:schema sidecar-schema}) "\n"
       (str/join "" (for [r (concat (sort-by record-order regions)
                                    (sort-by record-order tickets))]
                      (str (render-record r) "\n")))))

(defn save-state!
  "Writes the sidecar, or removes it when nothing is left to record."
  [{:keys [path regions tickets] :as state}]
  (swap! sidecar-cache dissoc path)
  (reset! stored-cache nil)
  (let [f (store-file path)]
    (if (and (empty? regions) (empty? tickets))
      (when (fs/exists? f) (fs/delete f))
      (do (fs/create-dirs (fs/parent f))
          (spit f (render-sidecar state))))
    state))

(defn- store-listing []
  (let [dir (fs/file *root* ".review" "sidecars")]
    (if (fs/exists? dir)
      (->> (fs/glob dir "**.jsonl" {:hidden true})
           (filter fs/regular-file?)
           (map #(str (fs/relativize (fs/path dir) %)))
           (map #(subs % 0 (- (count %) (count ".jsonl"))))
           sort vec)
      [])))

(defn stored-paths
  "The paths the store holds a sidecar for, listed once per run and again
   after `save-state!`, which can add one or remove one."
  []
  (or @stored-cache (reset! stored-cache (store-listing))))

(defn- parse-store!
  "Parse every sidecar on every core, into the cache `read-state` answers
   from. Each parse is independent of the others, and the writes that read
   the whole store call this before they do."
  []
  (dorun (pmap parse-sidecar (stored-paths))))

;; ---------------------------------------------------------------- projection

(defn parse-hunks
  "[{:old-start :old-count :new-start :new-count}] from a -U0 diff."
  [diff]
  (keep (fn [l]
          (when-let [[_ a b c d] (re-find #"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@" l)]
            {:old-start (parse-long a)
             :old-count (if b (parse-long b) 1)
             :new-start (parse-long c)
             :new-count (if d (parse-long d) 1)}))
        (str/split-lines (or diff ""))))

(defn diff-hunks
  "Hunks between the file as it was at review time and its content now.
   --no-index, so a rename or an untracked state needs no special case."
  [old-text new-text]
  (let [dir (fs/create-temp-dir {:prefix "legu"})]
    (try
      (let [a (fs/file (fs/file dir) "a")
            b (fs/file (fs/file dir) "b")]
        (spit a old-text :encoding ENC)
        (spit b new-text :encoding ENC)
        (parse-hunks (:out (p/sh {:out :string :err :string :continue true}
                                 "git" "diff" "--no-index" "-U0" "--" (str a) (str b)))))
      (finally (fs/delete-tree dir)))))

;; [commit path] -> hunks, for every file `fetch-hunks!` asked git about. nil
;; sends `try-anchor` down the per-file route of `diff-hunks`.
(def ^:private commit-hunks (atom {}))

(defn- diff-by-path
  "path -> hunks from one `git diff -U0` over many files. Only a file the
   commit and the working tree both hold as text is kept. A file new since
   the commit would come back as one hunk of every line where `diff-hunks`
   has no old text to diff, and a file git's attributes call binary as no
   hunks where `diff-hunks`, outside the repository, finds some. A path git
   quotes in the header is left out too, rather than unquoted here."
  [out]
  (loop [ls (str/split-lines out) cur nil acc {}]
    (if-let [l (first ls)]
      (cond
        (str/starts-with? l "diff --git ")
        (let [[_ p] (re-matches #"diff --git a/(.*) b/\1" l)]
          (recur (rest ls) p (if p (assoc acc p []) acc)))

        (and cur (some #(str/starts-with? l %)
                       ["new file mode " "deleted file mode " "Binary files "]))
        (recur (rest ls) nil (dissoc acc cur))

        (and cur (str/starts-with? l "@@ "))
        (recur (rest ls) cur (update acc cur into (parse-hunks l)))

        :else (recur (rest ls) cur acc))
      acc)))

(defn- runs-within
  "`paths` in runs whose lengths sum to at most `budget`, so that none
   overruns the kernel's limit on a command line."
  [budget paths]
  (loop [ps paths run [] n 0 acc []]
    (if-let [p (first ps)]
      (let [k (inc (count p))]
        (if (and (seq run) (> (+ n k) budget))
          (recur (rest ps) [p] k (conj acc run))
          (recur (rest ps) (conj run p) (+ n k) acc)))
      (cond-> acc (seq run) (conj run)))))

(defn- needs-hunks?
  "Will anchoring `record` at its own path diff it against its commit? Only
   when the text there changed since the review and git tracks the path.
   The hash is asked first: on a clean tree it answers for every record."
  [{:keys [path commit opaque file-hash]}]
  (and *git?*
       (not opaque)
       (let [c (read-worktree path)]
         (and (= :text (:kind c)) (not= file-hash (:hash c))))
       ((tracked-set) path)
       (re-matches #"[0-9a-f]{7,64}" (str commit))))

(defn fetch-hunks!
  "Diff each file `records` will anchor at its own path against the commit
   its records cite, one `git diff` per commit, so that no record spawns a
   process of its own. The pathspec holds only those files, so a mark pays
   for the records it anchors and no others."
  [records]
  (let [wanted (group-by first (uncached-pairs records needs-hunks? commit-hunks))]
    (doseq [[commit pairs] wanted
            paths (runs-within 100000 (map second pairs))]
      (let [by-path (diff-by-path
                     (or (apply git-ok "--literal-pathspecs" "diff" "-U0" "--no-renames"
                                "--no-color" "--no-ext-diff" "--no-textconv"
                                "--src-prefix=a/" "--dst-prefix=b/" commit "--" paths)
                         ""))]
        (swap! commit-hunks into (for [p paths] [[commit p] (get by-path p)]))))))

(def ^:private forward-cap
  "How many commits after the one a record cites the confirmation search tries
   (ADR-0018). A mark taken mid-edit is committed within a commit or two of
   itself, so a handful reaches the commit that holds what was read; past that
   the path has moved on and the record is better reported stale than diffed
   against a text nobody read. The cap bounds the blobs read and the diffs
   taken; the `git log` that finds the candidates names hashes only and stops
   at the commit the record cites."
  5)

;; [commit path] -> the commits after `commit` that touched `path`, oldest
;; first, at most `forward-cap` of them.
(def ^:private later-commits (atom {}))

(defn- log-by-path
  "The commits after `commit` that touched each of `paths`, oldest first, from
   one `git log`. Parsed like `commit-file-sets`: a commit's own token is the
   sentinel and its hash, and the newline git puts before the first path rides
   on the token after it. Topological order, because the fixed dates of a
   scripted history say nothing about which commit came first."
  [commit paths]
  (->> (str/split (or (apply git-ok "--literal-pathspecs" "log" "--reverse"
                             "--topo-order" "--name-only" "-z"
                             (str SENTINEL-FORMAT "%H") (str commit "..HEAD")
                             "--" paths)
                      "")
                  NUL)
       (reduce (fn [{:keys [at] :as acc} t]
                 (let [t (str/replace-first t #"^\n" "")]
                   (cond
                     (str/starts-with? t SENTINEL)
                     (assoc acc :at (subs t (count SENTINEL)))

                     (or (str/blank? t) (nil? at)) acc
                     :else (update-in acc [:by-path t] (fnil conj []) at))))
               {})
       :by-path))

(defn- gather-later-commits!
  "Find the commits the confirmation search may try for `records`, one
   `git log` per commit they cite, so that no record spawns a process of its
   own. They are gathered before any blob is read, so that the ones the search
   wants are asked for in the same batch as the ones the records cite."
  [records]
  (let [wanted (group-by first (uncached-pairs records needs-blob? later-commits))]
    (doseq [[commit pairs] wanted
            paths (runs-within 100000 (map second pairs))]
      (let [by-path (log-by-path commit paths)]
        (swap! later-commits into
               (for [p paths] [[commit p] (vec (take forward-cap (get by-path p)))]))))))

(defn- candidate-commits
  "The commits tried after `commit` for a record at `path`. A pair no gather
   asked for pays for a log of its own rather than going without, so a
   caller's answer never depends on having been prefetched."
  [commit path]
  (if-not *git?*
    []
    (let [k [commit path]]
      (when-not (contains? @later-commits k)
        (swap! later-commits assoc k
               (vec (take forward-cap (get (log-by-path commit [path]) path)))))
      (get @later-commits k))))

(defn- confirms?
  "Does `path` at `commit` hold the lines `record` signed for? The hash is
   ADR-0003's per-line trim, the one the record carries."
  [{:keys [path start end content-hash]} commit]
  (when-let [old (read-at-commit commit path)]
    (let [old-lines (lines-of old)]
      (and (<= end (count old-lines))
           (= content-hash (norm-hash (subvec old-lines (dec start) end)))))))

(defn anchor-commit
  "The commit a record's diff is taken from: the one it cites when that holds
   the text it signed for, else the first commit after it that does, and nil
   when none of them does (ADR-0018). A mark made on a dirty working tree
   cites a commit whose text it did not read, and the commit that carried the
   edit into git is where the read it recorded can be found."
  [{:keys [commit path] :as record}]
  (when (needs-blob? record)
    (if (confirms? record commit)
      commit
      (first (filter #(confirms? record %) (candidate-commits commit path))))))

(defn- forward-records
  "One copy of each record per commit the confirmation search may try it at,
   for the batch that reads their blobs."
  [records]
  (for [record records
        :when (needs-blob? record)
        commit (candidate-commits (:commit record) (:path record))]
    (assoc record :commit commit)))

(defn prefetch!
  "Ask git once for everything anchoring `records` will want: the commits the
   confirmation search may try, the file as it was at each of them, and the
   hunks since the commit each record is confirmed against. Every caller that
   anchors a batch goes through here, so a new cache is wired in one place."
  [records]
  (gather-later-commits! records)
  (fetch-blobs! (concat records (forward-records records)))
  (fetch-hunks! (for [record records]
                  (assoc record :commit (or (anchor-commit record) (:commit record))))))

(defn project-range
  "Shift [start end] across hunks. :dirty? when a hunk touched the region itself."
  [hunks start end]
  (reduce (fn [{:keys [offset] :as acc} {:keys [old-start old-count new-count]}]
            (let [old-end (+ old-start old-count -1)]
              (cond
                ;; a pure insertion sits after old-start, between two old lines
                (zero? old-count)
                (cond
                  (< old-start start) (assoc acc :offset (+ offset new-count))
                  (>= old-start end) acc
                  :else (assoc acc :dirty? true))

                (< old-end start) (assoc acc :offset (+ offset (- new-count old-count)))
                (> old-start end) acc
                :else (assoc acc :dirty? true))))
          {:offset 0 :dirty? false}
          hunks))

(defn- window-starts
  "hash -> ascending 1-based start lines of every window of `len` lines in
   `trimmed`, whose lines are trimmed already, which leaves `norm-hash`
   nothing to trim in each of the windows a line falls in."
  [trimmed len]
  (if-not (and (pos? len) (<= len (count trimmed)) (<= (count trimmed) 200000))
    {}
    (persistent!
     (reduce (fn [m i]
               (let [h (norm-hash (subvec trimmed i (+ i len)))]
                 (assoc! m h (conj (get m h []) (inc i)))))
             (transient {})
             (range (inc (- (count trimmed) len)))))))

;; [lines trimmed {len index}] for the file `file-windows` indexed last.
(def ^:private last-windows (atom nil))

(defn- file-windows
  "`window-starts` of a file's current `lines`, kept for the file asked about
   last. A file's records are anchored one after another, so between them
   they trim its lines once and hash its windows once per length, where
   keeping every file's would hold each stale file's index for the rest of
   the run."
  [lines len]
  (let [[indexed trimmed by-len] @last-windows
        [trimmed by-len] (if (identical? indexed lines)
                           [trimmed by-len]
                           [(mapv str/trim lines) {}])]
    (or (get by-len len)
        (let [index (window-starts trimmed len)]
          (reset! last-windows [lines trimmed (assoc by-len len index)])
          index))))

(defn occurrences
  "The first `cap` 1-based start lines in `index`, a `window-starts`, of the
   windows hashing to `want`. Callers only need to know whether the match
   is unique."
  [index want cap]
  (vec (take cap (get index want))))

(defn- insertion?
  "Did this hunk write lines without consuming any? Git names such a hunk by
   the old line it follows, so an insertion sits between `old-start` and the
   line after it, not on `old-start` itself. That is why the predicates below
   ask `< end` of an insertion where they ask `<= end` of a hunk with old
   lines: an insertion after the region's last line is outside it."
  [{:keys [old-count]}]
  (zero? old-count))

(defn- old-last
  "The last old line this hunk consumed."
  [{:keys [old-start old-count]}]
  (+ old-start old-count -1))

(defn- before-region?
  [{:keys [old-start] :as hunk} start]
  (if (insertion? hunk)
    (< old-start start)
    (< (old-last hunk) start)))

(defn- touches-region?
  [{:keys [old-start] :as hunk} start end]
  (if (insertion? hunk)
    (and (>= old-start start) (< old-start end))
    (and (<= old-start end) (>= (old-last hunk) start))))

(defn- deletion?
  "Did this hunk consume lines without writing any?"
  [{:keys [new-count]}]
  (zero? new-count))

(defn- new-first
  "The first line this hunk wrote. Git names a hunk that wrote nothing by the
   new line before the gap it left, so the line it would have written first is
   the one after that."
  [{:keys [new-start] :as hunk}]
  (if (deletion? hunk) (inc new-start) new-start))

(defn- new-last
  "The last line this hunk wrote. A hunk that wrote nothing gets an empty span
   here, one before `new-first`, as `old-last` gives an insertion."
  [{:keys [new-count] :as hunk}]
  (+ (new-first hunk) new-count -1))

(defn- lines-run
  "Lines `from` to `to`, 1-based and inclusive, or nil where the file does not
   hold them all. Empty where `to` is below `from`, as a hunk's absent side is."
  [lines from to]
  (when (and (>= from 1) (<= to (count lines)))
    (if (> from to) [] (subvec lines (dec from) to))))

(defn- shrink-hunk
  "ADR-0019: the hunk left when the lines its two sides share, whitespace
   apart, come off each end. A block wrapped in a new `if` is then the one
   line the wrap inserted, and a hunk that only moved whitespace is nothing at
   all. nil for that nothing; the hunk unshrunk where the texts given are not
   the ones it was taken from."
  [{:keys [old-start old-count new-start new-count] :as hunk} old-lines new-lines]
  (let [trimmed (fn [lines from to] (mapv str/trim (or (lines-run lines from to) [])))
        o (trimmed old-lines old-start (old-last hunk))
        n (trimmed new-lines (new-first hunk) (new-last hunk))]
    (if-not (and (= old-count (count o)) (= new-count (count n)))
      hunk
      (let [head (count (take-while true? (map = o n)))
            o* (subvec o head)
            n* (subvec n head)
            tail (count (take-while true? (map = (rseq o*) (rseq n*))))
            oc (- (count o*) tail)
            nc (- (count n*) tail)]
        (when (or (pos? oc) (pos? nc))
          ;; git names a side that wrote nothing by the line before what it
          ;; removed, one line back from where its lines would start.
          {:old-start (if (zero? old-count)
                        old-start
                        (+ old-start head (if (zero? oc) -1 0)))
           :old-count oc
           :new-start (if (zero? new-count)
                        new-start
                        (+ (new-first hunk) head (if (zero? nc) -1 0)))
           :new-count nc})))))

(defn- strict-hunks
  "The hunks of a change, whitespace apart. A per-hunk equivalence test cannot
   tell a block that moved with its wrapper from a line that moved out of one,
   so the hunks are taken strictly here and the whitespace question is put to
   each run of lines the strict hunks leave between them, in `reviewed-of`.
   ADR-0019 sets the rule this serves but describes the steps differently, as
   one check over the whole region; put to the region as a whole the question
   cannot separate the two cases. lgu-01m29ywrrzjj carries that amendment."
  [hunks old-lines new-lines]
  (keep #(shrink-hunk % old-lines new-lines) hunks))

(defn- overlap-of
  "The hunk's own old lines that lie inside the region [start end]. A hunk
   crossing the region's boundary lies inside it only in part, and that part
   is all the record answers for."
  [{:keys [old-start] :as hunk} start end]
  [(max start old-start) (min end (old-last hunk))])

(defn- clipped-of
  "ADR-0018: the new lines a hunk's stale fragment covers, clipped by prefix.
   It starts as far into the hunk's new lines as the region started into its
   old ones, and ends at the hunk's last new line, or at the region's
   projected end where the region ended first. Start past end where the hunk
   shrank below that offset and left the region nothing of its own: the seam
   case, which a deletion is always in."
  [{:keys [old-start] :as hunk} start end]
  (let [[from to] (overlap-of hunk start end)
        first-new (new-first hunk)]
    [(+ first-new (- from old-start))
     (if (= to (old-last hunk))
       (new-last hunk)
       (min (new-last hunk) (+ first-new (- to old-start))))]))

(defn- seam?
  "Did this hunk leave the region a seam line rather than lines of its own?"
  [hunk start end]
  (let [[from to] (clipped-of hunk start end)]
    (> from to)))

(defn- seam-after?
  "Does the seam fall after this hunk rather than before it? It does when the
   line after the hunk is still inside the region."
  [hunk end]
  (<= (inc (old-last hunk)) end))

(defn- seam-of
  "ADR-0018: the one line a hunk that left the region nothing of its own
   leaves stale — the line after what it wrote when that line is still inside
   the region, else the line before it, so the seam is always a line the
   reader read."
  [hunk end]
  (if (seam-after? hunk end) (inc (new-last hunk)) (dec (new-first hunk))))

(defn- stale-of
  "The new lines a hunk leaves stale under the region [start end]: the lines
   it wrote there, clipped, or the single seam line where it wrote none."
  [hunk start end]
  (let [[lo hi] (clipped-of hunk start end)]
    (if (<= lo hi) [lo hi] (repeat 2 (seam-of hunk end)))))

(defn- no-seam?
  "A hunk that swallowed the region whole: it left the region no line of its
   own, and `seam-of` has neither side to fall on, so nothing is left to
   stand for it."
  [{:keys [old-start] :as hunk} start end]
  (and (seam? hunk start end)
       (not (seam-after? hunk end))
       (< (dec old-start) start)))

(defn- claimed-of
  "The old lines a hunk's stale fragment answers for: the lines of the region
   it consumed, plus, where `seam-of` reached beside them, that line too. An
   insertion consumed none and sits between `old-start` and the line after
   it, an empty span."
  [{:keys [old-start] :as hunk} start end]
  (if (insertion? hunk)
    [(inc old-start) old-start]
    (let [[from to] (overlap-of hunk start end)]
      (cond
        (not (seam? hunk start end)) [from to]
        (seam-after? hunk end) [from (inc to)]
        :else [(dec from) to]))))

(defn- reviewed-of
  "The fragments a reviewed run of old lines [from to] leaves at `offset`.
   ADR-0019's second stage: one reviewed fragment where the run reads the same
   as it did, and otherwise the lines whose leading whitespace changed are the
   ones that broke the offsets, so they go stale and the rest of the run stays
   reviewed."
  [from to offset old-lines new-lines]
  (let [moved? (not (zero? offset))
        reviewed (fn [lo hi] {:state :reviewed :start (+ lo offset) :end (+ hi offset)
                              :moved? moved?})
        old-run (lines-run old-lines from to)
        new-run (lines-run new-lines (+ from offset) (+ to offset))]
    (if (or (nil? old-run) (nil? new-run) (same-read? old-run new-run))
      [(reviewed from to)]
      ;; against the run's own common indentation, so a line that moved with
      ;; the block around it is not the one that broke the offsets
      (->> (map (fn [n was now] [n (= (indent-of was) (indent-of now))])
                (range from (inc to)) (dedented old-run) (dedented new-run))
           (partition-by second)
           (mapv (fn [group]
                   (let [lo (ffirst group)
                         hi (first (last group))]
                     (if (second (first group))
                       (reviewed lo hi)
                       {:state :stale :start (+ lo offset) :end (+ hi offset)
                        :reason "content changed"}))))))))

(defn- fragments-of
  "ADR-0018: the fragments the region [start end] now falls into, given the
   `hunks` between the file as it was reviewed and the file now. Each hunk
   touching the region is stale at the lines it wrote there, or, where it
   wrote none, at the seam it left; the run of lines between two hunks is
   still reviewed, at the location the hunks before it left it, and moved when
   that location is not where it was read, unless ADR-0019 finds it is no
   longer the read it was.
   nil where the region holds the one hunk this rule cannot split: one that
   swallowed the region whole and left no seam. The caller then reports the
   whole region stale."
  [hunks start end old-lines new-lines]
  (let [touching (sort-by :old-start (filter #(touches-region? % start end) hunks))]
    (when (not-any? #(no-seam? % start end) touching)
      (loop [hs touching
             read-from start
             offset (reduce + 0 (for [h hunks :when (before-region? h start)]
                                  (- (:new-count h) (:old-count h))))
             acc []]
        (if-let [{:keys [old-count new-count] :as hunk} (first hs)]
          (let [[from to] (claimed-of hunk start end)
                [lo hi] (stale-of hunk start end)
                acc (cond-> acc
                      (< read-from from)
                      (into (reviewed-of read-from (dec from) offset
                                         old-lines new-lines)))]
            (recur (rest hs)
                   (inc to)
                   (+ offset (- new-count old-count))
                   (conj acc {:state :stale :start lo :end hi
                              :reason "content changed"})))
          (cond-> acc
            (<= read-from end)
            (into (reviewed-of read-from end offset old-lines new-lines))))))))

(defn try-anchor
  "Locate a record's reviewed content inside file `p`, whose content is `cur`.
   Returns a :reviewed or a :stale result, the latter carrying `:fragments`
   where a commit confirms the record and the diff since it says which of its
   lines changed."
  [{:keys [start end commit content-hash file-hash path] :as record} p cur]
  (if (= (:hash cur) file-hash)
    ;; byte-identical to review time: nothing to project
    {:state :reviewed :path p :start start :end end :moved? (not= p path)}
    (let [new-lines @(:lines cur)
          len (inc (- end start))
          ;; ADR-0018: the diff is only evidence about this record once the
          ;; file at the commit it is taken from holds the content the record
          ;; signed for. A mark made on a dirty working tree is confirmed by a
          ;; commit after the one it cites; a record no commit confirms keeps
          ;; the commit it cites and goes stale whole.
          confirming (anchor-commit record)
          diff-from (or confirming commit)
          old-text (read-at-commit diff-from path)
          old-lines (when old-text (lines-of old-text))
          hunks (or (when (= p path) (get @commit-hunks [diff-from path]))
                    (when old-text (diff-hunks old-text (:text cur))))
          confirmed? (some? confirming)
          ;; ADR-0019: the stored hash keeps ADR-0003's trim, so it says the
          ;; lines are there and not how they are laid out. Only the text at
          ;; the commit says that, so a record no commit confirms keeps the
          ;; trim alone.
          old-region (when confirmed? (subvec old-lines (dec start) end))
          same-read-at? (fn [from to]
                          (or (not confirmed?)
                              (when-let [run (lines-run new-lines from to)]
                                (same-read? old-region run))))
          {:keys [offset]} (if hunks (project-range hunks start end) {:offset 0})
          ns* (+ start offset)
          ne (+ end offset)
          in-bounds? (and (>= ns* 1) (<= ne (count new-lines)))]
      (if (and in-bounds?
               (= content-hash (norm-hash (subvec new-lines (dec ns*) ne)))
               (same-read-at? ns* ne))
        {:state :reviewed :path p :start ns* :end ne
         :moved? (or (not (zero? offset)) (not= p path))}
        ;; The region did not land where the diff said. Look for the block
        ;; elsewhere in the file — but only trust an unambiguous match: a block
        ;; that already had a twin at review time proves nothing about a move.
        (let [here (occurrences (file-windows new-lines len) content-hash 2)
              unique? (= 1 (count here))
              ;; the old text can only veto a unique match
              there (when (and unique? old-lines)
                      (occurrences (window-starts (mapv str/trim old-lines) len)
                                   content-hash 2))]
          (if (and unique? (or (nil? there) (<= (count there) 1))
                   (same-read-at? (first here) (+ (first here) len -1)))
            {:state :reviewed :path p :start (first here) :end (+ (first here) len -1)
             :moved? true :reason "block moved"}
            (let [total (count new-lines)
                  s (max 1 (min (if in-bounds? ns* start) total))
                  e (max s (min (if in-bounds? ne end) total))
                  frags (when confirmed?
                          (fragments-of (strict-hunks hunks old-lines new-lines)
                                        start end old-lines new-lines))]
              (cond-> {:state :stale :path p
                       :start (when (pos? total) s) :end (when (pos? total) e)
                       :reason "content changed"}
                frags (assoc :fragments
                             (mapv #(cond-> % (not= p path) (assoc :moved? true))
                                   frags))))))))))

(defn- candidate-paths
  "Where a record's file may have gone since `commit`. :renamed is git's own
   answer, and carries a mark with it even when the content changed; :added is
   a guess, and may only claim a mark whose content is actually found there."
  [commit path gone?]
  (if-not *git?*
    {:renamed [] :added []}
    (let [{:keys [renames added]} (diff-summary commit)]
      {:renamed (if-let [r (get renames path)] [r] [])
       :added (if gone? (take 1000 added) [])})))

(defn- may-have-moved?
  "Could a record stored under `path` anchor somewhere else? True wherever
   `candidate-paths` above has somewhere to look, decided without reading the
   file: git calls the file renamed, which needs it untracked or deleted, or
   nothing readable is there and the record may claim a file git calls added.
   The one disagreement with `candidate-paths` is a file `fs/readable?` accepts
   and `read-all-bytes` then refuses: gone there, present here, and a ghost
   survives the mark that should have retired it."
  [path]
  (let [f (fs/file *root* path)]
    (or (not (fs/regular-file? f))
        (not (fs/readable? f))
        (not ((tracked-set) path)))))

(defn resolve-region
  "Current state of a stored record against the working tree. A file that
   changed is diffed through `fetch-hunks!` when a caller ran it over this
   record first, as `resolve-regions` does, and on its own otherwise.
   => {:state :reviewed|:stale|:missing :path :start :end :moved? :reason},
   and :fragments where the record's lines did not all change together."
  [{:keys [path start end opaque file-hash commit] :as record}]
  (let [at-old (read-worktree path)
        gone? (not (#{:text :binary} (:kind at-old)))
        {:keys [renamed added]} (candidate-paths commit path gone?)]
    (if opaque
      (let [hit (first (for [p (concat [path] renamed added)
                             :let [c (read-worktree p)]
                             :when (= file-hash (:hash c))]
                         p))]
        (cond
          hit {:state :reviewed :path hit :moved? (not= hit path)}
          (not gone?) {:state :stale :path path :reason "content changed"}
          (seq renamed) {:state :stale :path (first renamed) :moved? true
                         :reason "content changed"}
          :else {:state :missing :path path :reason "file is gone"}))
      (let [old-res (when (= :text (:kind at-old)) (try-anchor record path at-old))
            look (fn [ps] (for [p ps
                                :let [c (read-worktree p)]
                                :when (= :text (:kind c))]
                            (assoc (try-anchor record p c) :moved? true)))]
        (if (= :reviewed (:state old-res))
          old-res
          ;; git's rename beats an unrelated file that took over the old path
          (let [moved (look renamed)]
            (or (first (filter #(= :reviewed (:state %)) moved))
                (first (filter #(= :reviewed (:state %)) (look added)))
                old-res
                (first moved)
              (case (:kind at-old)
                :binary {:state :stale :path path :start start :end end
                         :reason "file became binary"}
                :unreadable {:state :missing :path path :start start :end end
                             :reason "file is unreadable"}
                {:state :missing :path path :start start :end end
                 :reason "file is gone"}))))))))

(defn resolve-regions
  "`resolve-region` of each record, in order, with their files diffed a
   commit at a time and read at their commits in one batch first. Lazy, so a
   caller that folds the results never holds all of them at once."
  [records]
  (prefetch! records)
  (map resolve-region records))

;; ---------------------------------------------------------------- model

(defn records
  "Every stored review record, with :path merged in."
  []
  (vec (for [path (stored-paths)
             r (:regions (read-state path))]
         (assoc r :path path))))

(defn ticket-records
  "Every stored ticket reference, with :path merged in."
  []
  (vec (for [path (stored-paths)
             t (:tickets (read-state path))]
         (assoc t :path path))))

(defn- walk-files
  "Every file in the working tree, for when there is no git to ask."
  []
  (->> (fs/glob (fs/path *root*) "**" {:hidden true})
       (filter fs/regular-file?)
       (map #(str (fs/relativize (fs/path *root*) %)))
       (remove #(or (re-find #"(^|/)\.git/" %) (in-store? %)))
       sort vec))

(defn skipped-paths
  "Paths whose sidecar legu could not read. Their review state is unknown, so
   they are left out of the counts rather than reported as unreviewed — the
   `errors` key is what says they are missing from the numbers."
  []
  (run! read-state (stored-paths))
  (set (keys @store-errors)))

(defn eligible-files
  "Files whose lines count toward coverage, with their line counts. An empty
   file is one opaque region, and counts as one line like a binary does."
  []
  (let [ignored (ignored-files)
        skipped (skipped-paths)
        all (if *git?* (tracked-files) (walk-files))]
    (vec (for [p all
               :when (and (not (ignored p))
                          (not (skipped p))
                          (not (in-store? p)))]
           (let [c (read-worktree p)]
             ;; an opaque region is one line to read, whether binary or empty
             {:path p
              :binary (= :binary (:kind c))
              :lines (case (:kind c)
                       :text (max 1 (:line-count c))
                       :binary 1
                       0)})))))

(defn- fragments-or-whole
  "What a resolved record answers for: its fragments where the lines it covers
   did not all change together, and the record's own range otherwise."
  [res]
  (or (seq (:fragments res)) [res]))

(defn resolved-by-path
  "path -> {:reviewed [[start end] ...] :stale [[start end] ...]} at current
   locations, one range per fragment, overlapping as the records do."
  []
  (reduce (fn [acc res]
            (if (= :missing (:state res))
              acc
              (reduce (fn [acc {:keys [state start end]}]
                        (update-in acc [(:path res) state] (fnil conj [])
                                   (if start [start end] [1 1])))
                      acc
                      (fragments-or-whole res))))
          {}
          (resolve-regions (records))))

;; Coverage counts lines through [start end] ranges rather than sets of line
;; numbers: twenty overlapping records on each of 10,000 files are millions
;; of boxed line numbers as sets, and a few hundred thousand pairs as ranges.

(defn- merge-ranges
  "Sorted, disjoint ranges covering the lines of `ivs`, clamped to 1..total
   when a ceiling is given. Ranges that touch are joined, as `fmt-ranges`
   prints them."
  ([ivs] (merge-ranges ivs Long/MAX_VALUE))
  ([ivs total]
   (reduce (fn [acc [s e]]
             (let [s (max 1 s) e (min total e)]
               (cond
                 (> s e) acc
                 (and (seq acc) (<= s (inc (second (peek acc)))))
                 (conj (pop acc) [(first (peek acc)) (max e (second (peek acc)))])
                 :else (conj acc [s e]))))
           []
           (sort ivs))))

(defn- subtract-ranges
  "The lines of the merged ranges `ivs` outside the merged `minus`."
  [ivs minus]
  (reduce (fn [acc [s e]]
            (loop [s s acc acc minus minus]
              (let [[ms me] (first minus)]
                (cond
                  (or (nil? ms) (> ms e)) (if (<= s e) (conj acc [s e]) acc)
                  (< me s) (recur s acc (rest minus))
                  :else (recur (inc me)
                               (if (< s ms) (conj acc [s (dec ms)]) acc)
                               (rest minus))))))
          []
          ivs))

(defn- range-lines [ivs]
  (reduce + 0 (map (fn [[s e]] (inc (- e s))) ivs)))

(defn file-coverage
  "One eligible file's three numbers, and its reviewed lines as merged
   ranges. A stale line that a reviewed record also covers is reviewed."
  [by-path {:keys [path lines]}]
  (let [rev (merge-ranges (get-in by-path [path :reviewed]) lines)
        stl (subtract-ranges (merge-ranges (get-in by-path [path :stale]) lines) rev)]
    {:path path :total lines
     :reviewed (range-lines rev) :stale (range-lines stl)
     :unreviewed (- lines (range-lines rev) (range-lines stl))
     :reviewed-ranges rev}))

;; ---------------------------------------------------------------- helpers

(defn rel-path
  "Repo-root-relative form of a user-supplied path. Refuses to leave the repo."
  [p]
  (when (str/includes? p "\n")
    (die "path contains a newline"))
  (let [abs (str (fs/normalize (fs/absolutize (fs/path p))))
        root (str (fs/normalize (fs/absolutize (fs/path *root*))))]
    (cond
      (= abs root) "."
      (str/starts-with? abs (str root "/")) (subs abs (inc (count root)))
      :else (die (str "path is outside the repository: " p)))))

(defn- line-number [s]
  (or (parse-long s) (die (str "line number out of range: " s))))

(defn parse-target
  "src/a.clj:10-40 -> {:path :start :end}. The range is optional, and a file
   whose own name ends in a range-shaped suffix still wins."
  [s]
  (let [exists? (fn [x] (fs/regular-file? (fs/file *root* (rel-path x))))]
    (or (when-let [[_ path a b] (re-matches #"^(.+):(\d+)-(\d+)$" s)]
          (when-not (exists? s) {:path path :start (line-number a) :end (line-number b)}))
        (when-let [[_ path a] (re-matches #"^(.+):(\d+)$" s)]
          (when-not (exists? s) {:path path :start (line-number a) :end (line-number a)}))
        {:path s})))

(defn now
  "Stamp the moment as a whole second: a record's timestamp says when it was
   made, and nanoseconds would only widen the line."
  []
  (str (.truncatedTo (Instant/now) ChronoUnit/SECONDS)))

(defn reviewer [opts]
  (or (:reviewer opts)
      (some-> (git-ok "config" "user.name") str/trim not-empty)
      (System/getenv "USER")
      "unknown"))

(defn fmt-ranges
  "Merged ranges as 1-5,7,9-12, or - when there are none."
  [ivs]
  (if (empty? ivs)
    "-"
    (str/join "," (map (fn [[a b]] (if (= a b) (str a) (str a "-" b))) ivs))))

(defn fmt-region [{:keys [start end]}]
  (if start (str ":" start "-" end) ""))

(defn emit [opts data render]
  (doseq [[path reason] @store-errors]
    (binding [*out* *err*]
      (println (str "legu: cannot read " (store-file path) ": " reason))))
  (let [errors (vec (for [[path reason] @store-errors]
                      {:file (store-path path) :reason reason}))
        data (cond-> data (seq errors) (assoc :errors errors))]
    (if (:json opts)
      (println (json/generate-string data {:pretty true}))
      (render data))))

;; ---------------------------------------------------------------- terminal

(def ^:private ansi
  {:dim "[2m" :bold "[1m" :green "[32m" :yellow "[33m"
   :reset "[0m"})

(defn tty?
  "Whether a person is reading stdout. A pipe gets plain text."
  []
  (some? (System/console)))

(defn color? []
  (and (tty?) (nil? (System/getenv "NO_COLOR"))))

(defn paint [code s]
  (if (and code (color?)) (str (ansi code) s (ansi :reset)) s))

(defn terminal-width []
  (or (some-> (System/getenv "COLUMNS") parse-long)
      (when (tty?)
        (let [{:keys [exit out]} (p/sh {:out :string :err :string :continue true} "tput" "cols")]
          (when (zero? exit) (parse-long (str/trim out)))))
      80))

(defn bar
  "A bar FRACTION of WIDTH long. Anything too small for one cell still shows
   as a sliver, so a repository with a few lines read does not look like one
   with none."
  [fraction width]
  (let [n (Math/round (* fraction width))]
    (cond (pos? n) (apply str (repeat n "█"))
          (pos? fraction) "▏"
          :else "")))

(defn percent
  "FRACTION as a percentage that never rounds a few lines to nothing."
  [fraction]
  (let [pct (* 100.0 fraction)]
    (cond (and (pos? pct) (< pct 0.05)) " <0.1%"
          (and (< pct 100) (> pct 99.95)) ">99.9%"
          :else (format "%5.1f%%" pct))))

(defn shorten-path
  "PATH cut from the left to fit WIDTH, so the file name always survives."
  [path width]
  (if (> (count path) width)
    (str "…" (subs path (- (count path) (dec width))))
    path))

(defn path-column
  "How wide a column of PATHS wants to be: the longest of them, never so wide
   that one deep path pushes the numbers off the grid."
  [paths]
  (min 60 (max 20 (apply max 0 (map count paths)))))

(defn num-column
  "How wide a column of counts wants to be: its widest number, and never
   narrower than its HEADING."
  [heading ns]
  (max (count heading) (count (str (apply max 0 ns)))))

(defn cell
  "N in a column WIDTH wide, painted CODE unless it is a zero, which is dim
   whatever the column means."
  [n width code]
  (paint (if (zero? n) :dim code) (format (str "%" width "d") n)))

;; ---------------------------------------------------------------- keys

(defn- key-dir
  "Where this user's signing key lives (ADR-0016): legu/ under
   $XDG_CONFIG_HOME, or under ~/.config when that is unset or empty."
  []
  (fs/file (or (not-empty (System/getenv "XDG_CONFIG_HOME"))
               (fs/file (or (not-empty (System/getenv "HOME")) (str (fs/home))) ".config"))
           "legu"))

(defn- private-key-file [] (fs/file (key-dir) "key"))

(defn- public-key-file [] (fs/file (key-dir) "key.pub"))

(defn- base64 [^bytes bs]
  (.encodeToString (Base64/getEncoder) bs))

(defn cmd-key-init
  "Creates the signing key: the 32-byte seed in key, owner-only, and the
   32-byte public key in key.pub, each base64 on one line. Refuses when key
   exists, so a second run cannot destroy the key a signers list names."
  [{:keys [opts]}]
  (let [private (private-key-file)
        public (public-key-file)]
    (fs/create-dirs (fs/parent private))
    ;; babashka exposes no EdEC key classes, so the raw halves are cut out of
    ;; the JDK's DER encodings: the seed after PKCS#8's 16-byte header, the
    ;; public key after X.509's 12-byte one.
    (let [pair (.generateKeyPair (KeyPairGenerator/getInstance "Ed25519"))
          seed (Arrays/copyOfRange (.getEncoded (.getPrivate pair)) 16 48)
          public-key (base64 (Arrays/copyOfRange (.getEncoded (.getPublic pair)) 12 44))]
      ;; Owner-only from creation rather than chmodded after the seed is in it,
      ;; and create-file's refusal of an existing file is the overwrite check:
      ;; no separate test can race it.
      (try (fs/create-file private {:posix-file-permissions "rw-------"})
           (catch FileAlreadyExistsException _
             (die (str "a signing key already exists at " private
                       "; legu key init never replaces one"))))
      ;; A key file left empty by a failed write would refuse every later init.
      (try (spit private (str (base64 seed) "\n"))
           (spit public (str public-key "\n"))
           (catch Exception e
             (fs/delete-if-exists private)
             (throw e)))
      (emit opts {:private-key-file (str private) :public-key-file (str public)
                  :public-key public-key}
            (fn [_] (println (str "created " private " and " public)))))))

(defn- no-key [file]
  (die (str "no signing key at " file "; create one with legu key init")))

(defn- local-public-key
  "This machine's public key, from key.pub: babashka cannot derive it from the
   seed. Dies naming legu key init when there is none."
  []
  (let [public (public-key-file)]
    (or (when (fs/exists? public) (not-empty (str/trim (slurp public))))
        (no-key public))))

(defn- local-binding
  "The signers-list binding for this machine: the key from `local-public-key`
   and the name from git config user.name. Dies naming what supplies whichever
   half is missing."
  []
  (let [public-key (local-public-key)
        reviewer (some-> (git-ok "config" "user.name") str/trim not-empty)]
    (when-not reviewer
      (die (str "git config user.name is not set, and the signers list names the key"
                " after it; set it with git config user.name <name>")))
    {:public-key public-key :reviewer reviewer}))

;; The DER header PKCS#8 puts before an Ed25519 seed: babashka exposes no
;; EdEC key spec, so a seed becomes a private key through this encoding.
(def ^:private pkcs8-header
  (byte-array [0x30 0x2e 0x02 0x01 0x00 0x30 0x05 0x06 0x03 0x2b 0x65 0x70 0x04 0x22 0x04 0x20]))

;; And the one X.509 puts before an Ed25519 public key.
(def ^:private x509-header
  (byte-array [0x30 0x2a 0x30 0x05 0x06 0x03 0x2b 0x65 0x70 0x03 0x21 0x00]))

(defn- ed25519-sign [private-key ^bytes data]
  (.sign (doto (Signature/getInstance "Ed25519") (.initSign private-key) (.update data))))

(defn- ed25519-verify
  "Whether `signature` is `public-key`'s over `data`. False, not a throw, for
   64 bytes no key could have made: a signature comes from a sidecar anyone
   can edit."
  [public-key ^bytes data ^bytes signature]
  ;; babashka resolves none of the JDK's security exception classes, so the
  ;; SignatureException a malformed signature raises is caught as Exception.
  (try (.verify (doto (Signature/getInstance "Ed25519") (.initVerify public-key) (.update data))
                signature)
       (catch Exception _ false)))

(defn- ed25519-public-key
  "The public key for its 32 raw bytes."
  [^bytes raw]
  (.generatePublic (KeyFactory/getInstance "Ed25519")
                   (X509EncodedKeySpec. (byte-array (concat x509-header raw)))))

(defn- signing-key
  "The private key in key, checked against `public-key`, the half key.pub
   holds: halves from two pairs would sign records verify rejects. Dies when
   key holds no 32-byte seed or the halves disagree."
  [public-key]
  (let [private (private-key-file)
        unreadable #(die (str "cannot read the signing key at " private ": " %))
        seed (try (.decode (Base64/getDecoder) (str/trim (slurp private)))
                  (catch Exception e (unreadable (ex-message e))))
        _ (when-not (= 32 (alength seed)) (unreadable "not a 32-byte seed"))
        private-key (.generatePrivate
                     (KeyFactory/getInstance "Ed25519")
                     (PKCS8EncodedKeySpec. (byte-array (concat pkcs8-header seed))))
        public (try (ed25519-public-key (.decode (Base64/getDecoder) public-key))
                    (catch Exception e
                      (die (str "cannot read the public key at " (public-key-file) ": "
                                (ex-message e)))))
        probe (.getBytes "legu-key-check" "UTF-8")]
    (when-not (ed25519-verify public probe (ed25519-sign private-key probe))
      (die (str "the signing key at " private " is not the private half of "
                (public-key-file))))
    private-key))

(defn- signing-binding
  "The binding a mark signs under, or nil in an unsigned store, where no key
   is read. In a signed store the reviewer is the name the signers list gives
   this machine's key, so a --reviewer is refused rather than written into a
   record verify would reject. Reads and checks the private key here, before
   mark prunes anything. Dies unless a listed key can sign."
  [opts]
  (when (fs/exists? (signers-file))
    (when (contains? opts :reviewer)
      (die (str "a signed store takes the reviewer from " signers-path
                ", so mark does not take --reviewer")))
    (let [public-key (local-public-key)
          private (private-key-file)]
      (when-not (fs/exists? private)
        (no-key private))
      (-> (or (binding-of (signers-text) public-key)
              (die (str signers-path " does not list the key in " (public-key-file)
                        "; add it with legu key add")))
          (assoc :private-key (signing-key public-key))))))

(defn- sign-record
  "`record` with its signature: Ed25519 over `signed-bytes` with `private-key`,
   base64."
  [record private-key]
  (assoc record :signature (base64 (ed25519-sign private-key (signed-bytes record)))))

(defn- decode-base64
  "The bytes base64 `s` holds when it is a string holding exactly `n` of
   them, else nil."
  [s n]
  (when (string? s)
    (when-let [^bytes bs (try (.decode (Base64/getDecoder) ^String s)
                              (catch IllegalArgumentException _ nil))]
      (when (= n (alength bs)) bs))))

(defn- listed-public-key
  "The public key a signers-list line names, or nil when its text is not 32
   bytes of base64 that decode to an Ed25519 key."
  [s]
  (when-let [raw (decode-base64 s 32)]
    (try (let [public-key (ed25519-public-key raw)]
           ;; The JDK decodes the point only when a key is put to use, so a
           ;; bad one would otherwise throw from the first record it checks.
           (.initVerify (Signature/getInstance "Ed25519") public-key)
           public-key)
         (catch Exception _ nil))))

(defn- listed-bindings
  "The signers list's text as verify reads it: {:bindings :errors}. Each
   binding is {:reviewer :key} with the key decoded. A line that is not a
   binding, or whose key is no Ed25519 key, is an error {:line :text :reason}
   and binds nothing, as does a key listed a second time: one key binds to one
   reviewer."
  [text]
  (reduce (fn [acc {:keys [line text public-key reviewer]}]
            (let [key (some-> public-key listed-public-key)
                  error #(update acc :errors conj {:line line :text text :reason %})]
              (cond
                (nil? public-key) (error "not a public key, one space, then a name")
                (nil? key) (error "not a 32-byte Ed25519 public key in base64")
                (get-in acc [:lines public-key])
                (error (str "the key is already listed on line "
                            (get-in acc [:lines public-key])))
                :else (-> acc
                          (update :bindings conj {:reviewer reviewer :key key})
                          (assoc-in [:lines public-key] line)))))
          {:bindings [] :errors [] :lines {}}
          (signers-entries text)))

(defn- verify-outcome
  "[outcome reason] for a review record checked against `bindings`
   (ADR-0016). The record names no key and Ed25519 cannot say which key made
   a signature, so the reviewer's own keys are tried first and then every
   other: a key that verifies under another name is a name-mismatch, and no
   key verifying is a bad-signature when the reviewer has a listed key and an
   unlisted-signer when not."
  [bindings {:keys [reviewer] :as record}]
  (if-not (contains? record :signature)
    ["unsigned" "no signature in a signed store"]
    (if-let [signature (decode-base64 (:signature record) 64)]
      (let [data (signed-bytes record)
            binding (->> (sort-by #(not= reviewer (:reviewer %)) bindings)
                        (filter #(ed25519-verify (:key %) data signature))
                        first)
            ;; A hand-edited reviewer may be any JSON value, null included.
            named (if (string? reviewer) reviewer (json/generate-string reviewer))]
        (cond
          (and (nil? binding) (some #(= reviewer (:reviewer %)) bindings))
          ["bad-signature" (str "no key listed for " named " made this signature")]
          (nil? binding) ["unlisted-signer" (str signers-path " lists no key for " named)]
          (= reviewer (:reviewer binding)) ["valid" nil]
          :else ["name-mismatch" (str "signed by the key " signers-path " lists for "
                                      (:reviewer binding))]))
      ["bad-signature" "the signature is not 64 bytes of base64"])))

(defn- signers-line [{:keys [public-key reviewer]}]
  (str public-key " " reviewer))

(defn cmd-key-show [{:keys [opts]}]
  (let [binding (local-binding)]
    (emit opts (assoc binding :line (signers-line binding))
          (fn [{:keys [line]}] (println line)))))

(defn cmd-key-add
  "Lists this machine's key in the store's signers list, creating the list,
   and with it .review/, when absent. A key already listed under the same name
   is left as it is; under another name it is refused, since one key binds to
   one reviewer."
  [{:keys [opts]}]
  (let [{:keys [public-key reviewer] :as binding} (local-binding)
        f (signers-file)
        text (if (fs/exists? f) (signers-text) "")
        listed (binding-of text public-key)]
    (when (and listed (not= reviewer (:reviewer listed)))
      (die (str signers-path " already lists this key as " (:reviewer listed))))
    (when-not listed
      (fs/create-dirs (fs/parent f))
      ;; A hand-edited list may end without a newline, and appending straight
      ;; onto its last line would change that binding.
      (spit f (str (when-not (or (empty? text) (str/ends-with? text "\n")) "\n")
                   (signers-line binding) "\n")
            :append true))
    (emit opts (assoc binding :file signers-path :added (nil? listed))
          (fn [{:keys [added]}]
            (println (str (if added
                            (str "added to " signers-path ": ")
                            (str signers-path " already lists: "))
                          (signers-line binding)))))))

;; ---------------------------------------------------------------- commands

(defn region-of
  "Resolve a user target against the working tree. A binary or empty file is one
   opaque region with no line range."
  [t]
  (let [target (parse-target t)
        path (rel-path (:path target))
        cur (read-worktree path)]
    (when (#{:missing :unreadable} (:kind cur))
      (die (str (if (= :unreadable (:kind cur)) "cannot read file: " "no such file: ") path)))
    (let [total (or (:line-count cur) 0)
          opaque? (or (= :binary (:kind cur)) (zero? total))]
      (when (and opaque? (:start target))
        (die (str path (if (= :binary (:kind cur))
                         " is binary and has no line ranges"
                         " is empty and has no line ranges"))))
      (let [start (when-not opaque? (or (:start target) 1))
            end (when-not opaque? (or (:end target) total))]
        (when (and (not opaque?)
                   (or (< start 1) (> end total) (> start end)))
          (die (format "range %d-%d outside %s (1-%d)" start end path total)))
        {:path path :start start :end end :opaque opaque? :cur cur}))))

(defn- evidence-of
  "What a record stores about a region from `region-of` as it stands now:
   where it is, at which commit, what it looked like. An opaque region has no
   line range and nothing to hash but the file itself."
  [{:keys [start end opaque cur]}]
  (cond-> {:commit (or (head-sha) "-")
           :file-hash (:hash cur)
           :timestamp (now)}
    opaque (assoc :opaque true)
    (not opaque) (assoc :start start :end end
                        :content-hash (norm-hash (subvec @(:lines cur) (dec start) end)))))

(defn- same-region?
  "Does a stored record currently sit exactly where this region does?"
  [region record]
  (let [res (resolve-region record)]
    (and (= (:path region) (:path res))
         (= (:start region) (:start res))
         (= (:end region) (:end res)))))

(defn- superseded?
  "Is this ticket reference made obsolete by anchoring at `region`? Exactly the
   same place, or a whole-file anchor, or a record whose file no longer has the
   shape it was recorded with."
  [region record]
  (or (same-region? region record)
      (and (nil? (:start region))
           (= (:path region) (:path (resolve-region record))))
      (and (:opaque record)
           (:start region)
           (= (:path region) (:path (resolve-region record))))))

(defn- contained?
  "Is this review record made obsolete by a mark of `region`? Its current
   anchor lies fully inside the mark (ADR-0013). A mark of the whole file
   contains everything in it, and is the only mark that contains a record with
   no line range."
  [{:keys [whole?] :as region} record]
  (let [res (resolve-region record)]
    (and (not= :missing (:state res))
         (= (:path region) (:path res))
         (or whole?
             (and (:start res)
                  (<= (:start region) (:start res))
                  (<= (:end res) (:end region)))))))

(defn- can-hold-obsolete?
  "Can `sidecar` hold a record an anchoring at `path` makes obsolete? Only its
   own sidecar, and the ones whose file may have become it. Every other sidecar
   answers for a file of its own, and anchoring its records could only put them
   somewhere other than `path`, at the cost of diffing every file they cite."
  [path sidecar]
  (or (= sidecar path)
      (and *git?* (may-have-moved? sidecar))))

(defn- purge!
  "Drop every stored record that `obsolete?` says `region` makes obsolete,
   wherever its sidecar lives — a region re-reviewed after a rename must leave
   no ghost. `obsolete?` answers for one path at a time, which is what lets the
   sidecars that cannot hold an obsolete record go unanchored. Every sidecar is
   still read, so a write names the ones legu cannot parse."
  [region kind obsolete?]
  (parse-store!)
  (let [holders (vec (for [sidecar (stored-paths)
                           :let [state (read-state sidecar)]
                           :when (and state (can-hold-obsolete? (:path region) sidecar))]
                       state))]
    (let [rs (vec (for [state holders r (kind state)] (assoc r :path (:path state))))]
      (prefetch! rs))
    (doseq [{sidecar :path :as state} holders
            :let [keep? #(not (obsolete? region (assoc % :path sidecar)))
                  pruned (update state kind #(vec (filter keep? %)))]
            :when (not= state pruned)]
      (save-state! (assoc pruned :path sidecar)))))

(defn cmd-mark [{:keys [opts]}]
  (let [signing (signing-binding opts)
        {:keys [path start end opaque cur] :as region} (region-of (:target opts))
        whole? (or opaque (and (= 1 start) (= end (:line-count cur))))]
    (assert-readable! path)
    (purge! {:path path :start start :end end :whole? whole?} :regions contained?)
    (let [state (load-state path)
          record (cond-> (assoc (evidence-of region)
                                :reviewer (if signing (:reviewer signing) (reviewer opts)))
                   signing (sign-record (:private-key signing)))]
      (save-state! (update state :regions #(conj (vec %) record)))
      (when-let [why (cond
                       ((ignored-files) path) "is excluded by .review/ignore"
                       (and *git?* (not ((tracked-set) path))) "is not tracked by git")]
        (binding [*out* *err*]
          (println (str "legu: " path " " why " and will not count toward coverage"))))
      (emit opts {:marked path :start start :end end :commit (:commit record)}
            (fn [_] (println (format "marked %s%s reviewed at %s"
                                     path
                                     (if opaque " (whole file)" (str ":" start "-" end))
                                     (subs (:commit record) 0
                                           (min 8 (count (:commit record)))))))))))

(defn cmd-ticket [{:keys [opts]}]
  (let [ticket (:id opts)
        {:keys [path start end opaque] :as region} (region-of (:target opts))]
    (assert-readable! path)
    (purge! {:path path :start start :end end} :tickets
            (fn [region r] (and (= ticket (:ticket r)) (superseded? region r))))
    (let [state (load-state path)
          record (assoc (evidence-of region) :ticket ticket)]
      (save-state! (update state :tickets #(conj (vec %) record)))
      (emit opts {:anchored ticket :path path :start start :end end}
            (fn [_] (println (format "anchored %s at %s%s"
                                     ticket
                                     path (if opaque "" (str ":" start "-" end)))))))))

(defn under? [path prefix]
  (or (nil? prefix)
      (= prefix ".")
      (= path prefix)
      (str/starts-with? path (str prefix "/"))))

(defn- record-may-answer-path?
  "Return true when `record` stored under `stored-path` can anchor at `path`."
  [path stored-path record]
  (or (= path stored-path)
      (let [gone? (not (#{:text :binary} (:kind (read-worktree stored-path))))
            {:keys [renamed added]} (candidate-paths (:commit record) stored-path gone?)]
        (boolean (some #{path} (concat renamed added))))))

(defn- records-answering-path
  "Return readable records that anchor at `path`.
   Reads every sidecar so `emit` can report an incomplete answer."
  [path kind]
  (let [candidates (vec (for [stored-path (stored-paths)
                              :let [state (read-state stored-path)]
                              record (kind state)
                              :when (record-may-answer-path? path stored-path record)]
                          (assoc record :path stored-path)))]
    (vec (for [[stored current] (map vector candidates (resolve-regions candidates))
               :when (= path (:path current))]
           {:stored stored :current current}))))

(defn- original-provenance
  "Where and when a record was made. An opaque record reports null bounds."
  [record]
  (cond-> {:path (:path record) :start (:start record) :end (:end record)
           :commit (:commit record) :timestamp (:timestamp record)}
    (contains? record :reviewer) (assoc :reviewer (:reviewer record))))

(defn- current-record
  [{:keys [stored current]}]
  (let [anchored? (not= :missing (:state current))]
    (cond-> {:start (when anchored? (:start current))
             :end (when anchored? (:end current))
             :state (name (:state current))
             :reason (:reason current)
             :moved (boolean (:moved? current))
             :opaque (boolean (:opaque stored))
             :original (original-provenance stored)}
      (contains? stored :ticket) (assoc :ticket (:ticket stored)))))

(defn- current-records
  "One item per fragment of a record's current anchor, each carrying the whole
   record's provenance and its own location, so a reader of one line is told
   about the fragment that line falls in."
  [{:keys [stored current]}]
  (mapv (fn [fragment]
          (current-record {:stored stored
                           :current (merge (dissoc current :fragments)
                                           (select-keys fragment
                                                        [:state :start :end :moved?])
                                           {:reason (:reason fragment)})}))
        (fragments-or-whole current)))

(defn- path-eligibility [path ignored]
  (cond
    (in-store? path) [false "legu metadata"]
    (ignored path) [false "excluded by .review/ignore"]
    (and *git?* (not ((tracked-set) path))) [false "not tracked by git"]
    :else [true nil]))

(defn- render-current-record [path record]
  (let [original (:original record)
        where (str path (fmt-region record))
        source (str (:path original) (fmt-region original))
        moved (when (not= where source) (str " from " source))]
    (println
     (format "  %-28s %-8s%s%s  reviewed at %s by %s, commit %s"
             where (:state record)
             (if-let [reason (:reason record)] (str " (" reason ")") "")
             (or moved "")
             (or (:timestamp original) "?")
             (or (:reviewer original) "?")
             (or (:commit original) "?")))))

(defn- render-current-ticket [path ticket]
  (let [original (:original ticket)
        source (str (:path original) (fmt-region original))]
    (println
     (format "    %s%s  %s  [%s]%s; recorded %s, anchored %s at %s"
             path (fmt-region ticket) (:ticket ticket) (:state ticket)
             (if-let [reason (:reason ticket)] (str " (" reason ")") "")
             source
             (or (:timestamp original) "?")
             (or (:commit original) "?")))))

(defn- anchored-over
  "The ranges review records and ticket references anchor at within
   `[start end]` of `path`, as the current locations forget would match. Each
   range once, whatever anchors there, with the fragments of one record folded
   back into the record's own range."
  [path start end]
  (let [touching? (fn [r] (and (:start r) (<= (:start r) end) (<= start (:end r))))
        whole (fn [{:keys [current]}]
                (when (not= :missing (:state current))
                  (select-keys current [:start :end :opaque])))]
    (->> (concat (records-answering-path path :regions)
                 (records-answering-path path :tickets))
         (keep whole)
         (filter touching?)
         distinct
         (sort-by (juxt :start :end)))))

(defn- refuse-empty-forget!
  "Die for a forget that dropped nothing. One that named a range says what is
   anchored across it, so the caller can name a record that exists instead."
  [path start end]
  (let [where (str path (fmt-region {:start start :end end}))]
    (if-not start
      (die (str "nothing to forget at " where))
      (let [found (anchored-over path start end)
            covering? (every? #(and (<= (:start %) start) (<= end (:end %))) found)]
        (die (if (empty? found)
               (str "nothing to forget at " where)
               (format "no record anchored at %s; records %s it: %s"
                       where (if covering? "covering" "overlapping")
                       (str/join ", " (map #(str path (fmt-region %)) found)))))))))

(defn cmd-forget [{:keys [opts]}]
  (let [target (parse-target (:target opts))
        path (rel-path (:path target))
        {:keys [start end]} target
        region {:path path :start start :end end}
        ;; the file may be long gone: match where a record sits now, or where
        ;; it was recorded
        stored-match? (fn [sidecar r]
                        (and (= sidecar path)
                             (or (nil? start)
                                 (and (= start (:start r)) (= end (:end r))))))
        dropped (atom 0)]
    (assert-readable! path)
    (parse-store!)
    (when start
      (let [rs (vec (concat (records) (ticket-records)))]
        (prefetch! rs)))
    (doseq [sidecar (stored-paths)
            :let [state (read-state sidecar)]
            :when state
            :let [keep? (fn [r]
                          (if (or (stored-match? sidecar r)
                                  (and start (same-region? region (assoc r :path sidecar))))
                            (do (swap! dropped inc) false)
                            true))
                  pruned (-> state
                             (update :regions #(vec (filter keep? %)))
                             (update :tickets #(vec (filter keep? %))))]
            :when (not= state pruned)]
      (save-state! (assoc pruned :path sidecar)))
    ;; Forget acts on whole records (ADR-0018): a range inside one matches
    ;; nothing, and saying so with exit 0 was a silent no-op in every caller.
    (when (zero? @dropped)
      (refuse-empty-forget! path start end))
    (emit opts {:forgot @dropped :path path :start start :end end}
          (fn [_] (println (format "forgot %d record%s at %s%s"
                                   @dropped (if (= 1 @dropped) "" "s") path
                                   (if start (str ":" start "-" end) "")))))))

(defn cmd-regions [{:keys [opts]}]
  (let [path (rel-path (:path opts))
        file (fs/file *root* path)]
    (when (fs/directory? file) (die (str "path is a directory: " path)))
    (let [cur (read-worktree path)
          review-records (records-answering-path path :regions)
          tickets (records-answering-path path :tickets)
          known? (or (not= :missing (:kind cur))
                     ((tracked-set) path)
                     (some #(= path %) (stored-paths)))]
      (when-not known? (die (str "no such file: " path)))
      (let [ignored (ignored-files)
            [eligible exclusion] (path-eligibility path ignored)
            condition (name (:kind cur))
            total (case (:kind cur)
                    :text (max 1 (:line-count cur))
                    :binary 1
                    0)
            opaque (or (= :binary (:kind cur))
                       (and (= :text (:kind cur)) (zero? (:line-count cur))))
            regions (->> review-records
                         (mapcat current-records)
                         (sort-by (juxt #(or (:start %) 0)
                                        #(get-in % [:original :timestamp])))
                         vec)
            ticket-refs (->> tickets
                             (map current-record)
                             (sort-by (juxt #(or (:start %) 0) :ticket))
                             vec)
            data (cond-> {:path path
                          :eligible eligible
                          :condition (case condition
                                       "text" "present"
                                       "binary" "present"
                                       condition)
                          :total total
                          :opaque opaque
                          :complete (empty? @store-errors)
                          :regions regions
                          :tickets ticket-refs}
                   exclusion (assoc :exclusion-reason exclusion))]
        (emit opts data
              (fn [answer]
                (println
                 (str (:path answer) ": " (:condition answer)
                      ", " (if (:eligible answer) "eligible" (:exclusion-reason answer))
                      ", " (:total answer) (if (= 1 (:total answer)) " line" " lines")
                      (when (:opaque answer) ", opaque")
                      (when-not (:complete answer) ", incomplete")))
                (if (empty? (:regions answer))
                  (println "  no review records")
                  (doseq [record (:regions answer)]
                    (render-current-record path record)))
                (when (seq (:tickets answer))
                  (println "  tickets")
                  (doseq [ticket (:tickets answer)]
                    (render-current-ticket path ticket)))))))))

(defn render-coverage
  "The three numbers of the scope, as three rows on one bar scale. Never one
   number: the stale row says whether the reader is gaining ground."
  [{:keys [files lines unreviewed reviewed stale]} scope]
  (let [denominator (max 1 lines)
        width (max 8 (min 40 (- (terminal-width) 34)))]
    (println)
    (doseq [[label n code] [["unreviewed" unreviewed :dim]
                            ["reviewed" reviewed :green]
                            ["stale" stale :yellow]]]
      (let [fraction (/ (double n) denominator)]
        (println (str "  " (paint code (format "%-12s" label))
                      (format "%8d  " n)
                      (paint (when (zero? n) :dim) (percent fraction))
                      "  " (paint code (bar fraction width))))))
    (println (paint :dim (str "  " (format "%-12s" "eligible")
                              files (if (= 1 files) " file" " files")
                              " · " lines (if (= 1 lines) " line" " lines")
                              (when scope (str " · under " scope)))))))

(defn render-files [files hidden]
  (println)
  (println (str (paint :bold "FILES") "  "
                (paint :dim (str (count (remove :fully-reviewed files)) " with gaps · "
                                 (+ hidden (count (filter :fully-reviewed files)))
                                 " fully reviewed"
                                 (when (pos? hidden) " (hidden)")))))
  (when (seq files)
    (let [path-width (path-column (map :path files))
          [rw sw uw tw] (map #(num-column % (map :total files))
                             ["REVIEWED" "STALE" "UNREVIEWED" "TOTAL"])]
      (println (paint :dim (str "  " (format (str "%-" path-width "s") "PATH")
                                "  " (format (str "%" rw "s") "REVIEWED")
                                "  " (format (str "%" sw "s") "STALE")
                                "  " (format (str "%" uw "s") "UNREVIEWED")
                                "  " (format (str "%" tw "s") "TOTAL")
                                "  REVIEWED RANGES")))
      (doseq [f files]
        (println (str "  " (format (str "%-" path-width "s") (shorten-path (:path f) path-width))
                      "  " (cell (:reviewed f) rw :green)
                      "  " (cell (:stale f) sw :yellow)
                      "  " (cell (:unreviewed f) uw nil)
                      "  " (format (str "%" tw "d") (:total f))
                      "  " (cond (:fully-reviewed f) (paint :dim "fully reviewed")
                                 (empty? (:reviewed-ranges f)) (paint :dim "none")
                                 :else (fmt-ranges (:reviewed-ranges f)))))))))

(defn render-tickets [tickets]
  (when (seq tickets)
    (println)
    (println (str (paint :bold "TICKETS") "  " (paint :dim (str (count tickets)))))
    (let [longest (apply max 0 (map #(count (str (:path %) (fmt-region %))) tickets))
          width (min 60 (max 20 longest))]
      (doseq [t tickets]
        (println (str "  " (format (str "%-" width "s")
                                   (shorten-path (str (:path t) (fmt-region t)) width))
                      "  " (:ticket t)
                      "  " (paint (case (:state t) :stale :yellow :reviewed :green :dim)
                                  (name (:state t)))))))))

(defn cmd-status [{:keys [opts]}]
  (let [prefix (some-> (:path opts) (str/replace #"/$" "") rel-path)
        scope (when (and prefix (not= prefix ".")) prefix)
        by-path (resolved-by-path)
        all-files (->> (eligible-files)
                       (filter #(under? (:path %) prefix))
                       (map #(file-coverage by-path %))
                       (map #(assoc % :fully-reviewed (= (:reviewed %) (:total %))))
                       (sort-by :path))
        files (if (:gaps opts) (remove :fully-reviewed all-files) all-files)
        hidden (- (count all-files) (count files))
        coverage {:files (count all-files)
                  :lines (reduce + 0 (map :total all-files))
                  :unreviewed (reduce + 0 (map :unreviewed all-files))
                  :reviewed (reduce + 0 (map :reviewed all-files))
                  :stale (reduce + 0 (map :stale all-files))}
        tickets (->> (let [ts (ticket-records)]
                       (map (fn [t res] (assoc res :ticket (:ticket t))) ts (resolve-regions ts)))
                     (filter #(under? (:path %) prefix))
                     (sort-by (juxt :path #(or (:start %) 0))))
        data {:coverage coverage
              :files (mapv #(-> (dissoc % :reviewed-ranges :fully-reviewed)
                                (assoc :ranges (fmt-ranges (:reviewed-ranges %))))
                           files)
              :tickets (mapv #(-> (select-keys % [:path :start :end :ticket])
                                  (assoc :state (name (:state %))))
                             tickets)}]
    (emit opts data
          (fn [_]
            (if (empty? all-files)
              (println (str "no eligible files" (when scope (str " under " scope))))
              (do (render-coverage coverage scope)
                  (render-files files hidden)))
            (render-tickets tickets)))))

(defn- stale-and-reviewed
  "The stale fragments of every record, and the reviewed ranges of each path, in
   one pass over the store: anchoring a file's records twice would hash its
   windows again for every record read out of order."
  [resolutions]
  (reduce (fn [acc res]
            (reduce (fn [acc {:keys [state start end reason]}]
                      (if (= :reviewed state)
                        (cond-> acc
                          start (update-in [:reviewed (:path res)] (fnil conj [])
                                           [start end]))
                        (update acc :stale conj
                                {:path (:path res) :start start :end end
                                 :reason reason :state (name state)})))
                    acc
                    (fragments-or-whole res)))
          {:stale [] :reviewed {}}
          resolutions))

(defn cmd-stale [{:keys [opts]}]
  (let [{:keys [stale reviewed]} (stale-and-reviewed (resolve-regions (records)))
        ;; Staleness is per line (CONTEXT.md), so a fragment a later read
        ;; covers in part is reported at the lines that read left over, not
        ;; whole and not dropped. `subtract-ranges` is the rule the numbers
        ;; and `next` already follow; it wants its `minus` sorted and disjoint.
        merged (into {} (for [[path ivs] reviewed] [path (merge-ranges ivs)]))
        uncovered (fn [{:keys [path start end] :as item}]
                    (if-not start
                      [item]
                      (for [[s e] (subtract-ranges [[start end]] (get merged path))]
                        (assoc item :start s :end e))))
        rs (->> stale
                (mapcat uncovered)
                (sort-by (juxt :path #(or (:start %) 0))))]
    (emit opts {:stale (mapv #(select-keys % [:path :start :end :reason :state]) rs)}
          (fn [_]
            (if (empty? rs)
              (println "nothing stale")
              (doseq [r rs]
                (println (format "%s%s  %s  (%s)"
                                 (:path r) (fmt-region r)
                                 (:state r) (:reason r)))))))))

(defn- reviewed-paths
  "Paths carrying a reviewed line, current or stale, at their location now."
  [by-path]
  (set (for [[path states] by-path
             :when (some seq (vals states))]
         path)))

(defn cochange-scores
  "path -> the number of commits in which it changed alongside a file that
   already carries a reviewed line. A file never scores itself: a commit
   touching one reviewed file and nothing else says nothing about what to read
   next. Git history only — no language knows what a file means here."
  [already-reviewed]
  (reduce (fn [acc paths]
            (let [here (set/intersection paths already-reviewed)]
              (if (empty? here)
                acc
                (reduce (fn [a p]
                          (if (= #{p} here)
                            a
                            (update a p (fnil inc 0))))
                        acc paths))))
          {}
          (commit-file-sets)))

(defn render-queue
  "The queue: what to read next, and under which question. The heading says
   how much of the queue is on screen, so a --limit never reads as the end
   of the work."
  [files total cochange?]
  (println)
  (println (str (paint :bold "QUEUE") "  "
                (paint :dim (str (when (> total (count files))
                                   (str (count files) " of "))
                                 total (if (= 1 total) " file" " files")
                                 " with gaps · "
                                 (if cochange?
                                   "co-change with what you have reviewed"
                                   "directory order")))))
  (let [path-width (path-column (map :path files))
        [uw sw] (map #(num-column % (map (fn [f] (+ (:unreviewed f) (:stale f))) files))
                     ["UNREVIEWED" "STALE"])]
    (println (paint :dim (str "  " (format (str "%-" path-width "s") "PATH")
                              "  " (format (str "%" uw "s") "UNREVIEWED")
                              "  " (format (str "%" sw "s") "STALE")
                              "  TO READ")))
    (doseq [f files]
      (println (str "  " (format (str "%-" path-width "s")
                                 (shorten-path (:path f) path-width))
                    "  " (cell (:unreviewed f) uw nil)
                    "  " (cell (:stale f) sw :yellow)
                    "  " (if (= (range-lines (:todo f)) (:total f))
                           (paint :dim "whole file")
                           (fmt-ranges (:todo f))))))))

(defn cmd-next [{:keys [opts]}]
  (let [cochange? (= "cochange" (:order opts))]
    (when (and cochange? (not *git?*))
      (die "--order cochange needs git to read commit history"))
    (let [by-path (resolved-by-path)
          limit (or (:limit opts) 20)
          ;; Directory order is the tiebreak under every ordering, so with
          ;; nothing reviewed yet cochange order is directory order.
          scores (if cochange? (cochange-scores (reviewed-paths by-path)) {})
          rank (fn [f] [(- (get scores (:path f) 0))
                        (str (fs/parent (fs/path (:path f))))
                        (:path f)])
          with-gaps (->> (eligible-files)
                         (map #(file-coverage by-path %))
                         (filter #(pos? (+ (:unreviewed %) (:stale %))))
                         (sort-by rank))
          gaps (->> with-gaps
                    (take limit)
                    (mapv (fn [f]
                            (assoc f :todo (subtract-ranges [[1 (:total f)]]
                                                               (:reviewed-ranges f))))))]
      (emit opts {:next (mapv (fn [f] {:path (:path f)
                                       :unreviewed (:unreviewed f)
                                       :stale (:stale f)
                                       :ranges (fmt-ranges (:todo f))})
                              gaps)}
            (fn [_]
              (if (empty? gaps)
                (println "everything is reviewed and current")
                (render-queue gaps (count with-gaps) cochange?)))))))

(defn cmd-coverage [{:keys [opts]}]
  (let [by-path (resolved-by-path)
        files (map #(file-coverage by-path %) (eligible-files))
        total (reduce + 0 (map :total files))
        rev (reduce + 0 (map :reviewed files))
        stl (reduce + 0 (map :stale files))
        unr (- total rev stl)]
    (emit opts {:eligible-files (count files) :eligible-lines total
                :unreviewed unr :reviewed rev :stale stl}
          (fn [_]
            (if (empty? files)
              (println "no eligible files")
              (render-coverage {:files (count files) :lines total
                                :unreviewed unr :reviewed rev :stale stl}
                               nil))))))

(defn- render-verify [{:keys [records signers-errors errors]}]
  (doseq [{:keys [line text reason]} signers-errors]
    (println (format "%s:%d  %s  (%s)" signers-path line text reason)))
  (let [failed (remove #(= "valid" (:outcome %)) records)
        n (count records)
        plural (fn [k one many] (str k " " (if (= 1 k) one many)))]
    (doseq [r failed]
      (println (format "%s  %s%s  %s  %s  (%s)"
                       (:file r) (:path r) (fmt-region r) (:reviewer r) (:outcome r) (:reason r))))
    (println (str (plural n "review record" "review records") ", "
                  (if (empty? failed) "all valid" (str (count failed) " not valid"))
                  (when (seq signers-errors)
                    (str "; " (plural (count signers-errors)
                                      (str "line of " signers-path " does not parse")
                                      (str "lines of " signers-path " do not parse"))))
                  (when (seq errors)
                    (str "; " (plural (count errors) "sidecar could not be read"
                                      "sidecars could not be read")))))))

(defn cmd-verify
  "Verifies every review record under the path, or in the whole store, against
   the signers list (ADR-0016), and exits 1 after reporting when a record is
   not valid, a sidecar cannot be read or a signers-list line does not parse.
   Reads no local key. In an unsigned store there is nothing to verify."
  [{:keys [opts]}]
  (if-not (fs/exists? (signers-file))
    (emit opts {:signed false :records [] :signers-errors []}
          (fn [_] (println (str "the store is not signed: there is no " signers-path))))
    (let [prefix (some-> (:path opts) (str/replace #"/$" "") rel-path)
          {:keys [bindings errors]} (listed-bindings (signers-text))
          ;; Scoped before read-state, which records every sidecar it cannot
          ;; read, so that one outside the path does not fail the run.
          records (vec (for [path (stored-paths)
                             :when (under? path prefix)
                             record (:regions (read-state path))
                             :let [[outcome reason] (verify-outcome bindings record)]]
                         (cond-> {:file (store-path path) :path path}
                           (:start record) (assoc :start (:start record) :end (:end record))
                           :always (assoc :reviewer (:reviewer record)
                                          :outcome outcome :reason reason))))
          failed (or (some #(not= "valid" (:outcome %)) records)
                     (seq errors)
                     (seq @store-errors))]
      (emit opts {:signed true :records records :signers-errors errors} render-verify)
      (when failed
        (flush)
        (System/exit 1)))))

;; ---------------------------------------------------------------- cli

(def options
  "The options legu itself takes, declared at the dispatch level. babashka.cli
   exempts these from a command's :restrict, which is what lets them stand on
   either side of the command now that the rest may not."
  {:json {:coerce :boolean :desc "machine-readable output"}
   :version {:coerce :boolean :desc "this legu's version and the store schema it writes"}
   :help {:coerce :boolean :alias :h :desc "this help"}})

(def command-options
  "The options that belong to one command each. Every other command refuses
   them, so a flag that would have done nothing says so."
  {:reviewer {:validate #(and (string? %) (not (str/blank? %)))
              :desc "who read it (default: git config user.name; refused in a signed store)"}
   :limit {:coerce :long :validate pos? :desc "how many files `next` suggests"}
   ;; An enum, not a set: it keeps the order it is written in, so help and the
   ;; error name dir first, as the default and as the order a reader meets.
   :order {:enum ["dir" "cochange"] :desc "`next` order (default: dir)"}
   :gaps {:coerce :boolean :desc "hide fully reviewed files from `status`"}})

(def commands
  "One entry per command. :doc is both its line in `legu --help` and the
   description in its own help; :arguments names the arguments it takes, in
   order, :optional the ones it can run without, and :options the keys of
   command-options it reads. An entry without :run is a group: it runs
   nothing itself, and the entries whose :cmds extend its own are its
   subcommands."
  [{:cmds ["mark"] :run cmd-mark :arguments [:target] :options [:reviewer]
    :doc "mark a region reviewed as it stands in the working tree"}
   {:cmds ["ticket"] :run cmd-ticket :arguments [:target :id]
    :doc "anchor a ticket reference"}
   {:cmds ["forget"] :run cmd-forget :arguments [:target]
    :doc "drop the records anchored at a region; fails when there are none"}
   {:cmds ["status"] :run cmd-status :arguments [:path] :optional #{:path}
    :options [:gaps]
    :doc "per-file review state"}
   {:cmds ["regions"] :run cmd-regions :arguments [:path]
    :doc "anchored records for one file"}
   {:cmds ["stale"] :run cmd-stale :arguments []
    :doc "regions needing a re-read"}
   {:cmds ["next"] :run cmd-next :arguments [] :options [:limit :order]
    :doc "what to read next"}
   {:cmds ["coverage"] :run cmd-coverage :arguments []
    :doc "unreviewed / reviewed / stale"}
   {:cmds ["key"]
    :doc "this machine's signing key and the store's signers list"}
   {:cmds ["key" "init"] :run cmd-key-init :arguments []
    :doc "create the signing key"}
   {:cmds ["key" "show"] :run cmd-key-show :arguments []
    :doc "print the signers-list line for the signing key"}
   {:cmds ["key" "add"] :run cmd-key-add :arguments []
    :doc "add the signing key to the store's signers list"}
   {:cmds ["verify"] :run cmd-verify :arguments [:path] :optional #{:path}
    :doc "report each review record whose signature does not hold"}])

(def argument-specs
  "What each argument is called in help and what its value must satisfy. The
   keys are shared across commands because the argument means the same thing
   wherever it appears; a ticket id typed as an empty string would anchor
   nothing to a region."
  {:target {:desc "path[:<start>-<end>]"}
   :id {:desc "the ticket's id in its own tracker"
        :validate #(not (str/blank? %))}
   :path {:desc "limit to this file or directory"}})

(defn argument-ref
  "How an argument is written wherever a reader meets it: <target> when the
   command needs it, [<path>] when it runs without one. babashka.cli renders
   every positional as <name> unless :ref says otherwise, so the brackets are
   legu's to supply."
  [argument optional]
  (if (contains? optional argument)
    (str "[<" (name argument) ">]")
    (str "<" (name argument) ">")))

(defn command-named
  "The command a dispatch path names, or nil at the root."
  [dispatch]
  (first (filter #(= dispatch (:cmds %)) commands)))

(defn missing-argument
  "The argument to name when a command is short of one: the first it declares,
   is not content to run without, and did not get. Naming the first rather than
   any of them is what makes a bare `legu ticket` ask for <target>, the one the
   reader has to supply before <id> means anything."
  [{:keys [arguments optional]} opts]
  (when-let [argument (first (remove #(or (contains? optional %) (contains? opts %))
                                     arguments))]
    (str "required argument: " (argument-ref argument optional))))

(defn refused-value
  "What legu says about an argument value the spec turns down."
  [argument optional value]
  (str "invalid value for argument " (argument-ref argument optional) ": " value))

(defn refused-argument
  "The message for an argument whose value the spec turns down. An argument
   standing after the terminator is filled in once the parser has finished, so
   the :validate the spec declares reaches it here instead of there. Both paths
   word it the same way."
  [{:keys [arguments optional]} opts]
  (some (fn [argument]
          (let [check (:validate (argument-specs argument))
                value (get opts argument)]
            (when (and check (contains? opts argument) (not (check value)))
              (refused-value argument optional value))))
        arguments))

(defn argument-spec
  "The spec entries for a command's arguments. :positional both puts them under
   Arguments: in help and refuses them as flags, so `legu mark --target x` is
   the unknown option it has always been."
  [{:keys [arguments optional]}]
  (into {} (for [a arguments]
             [a (assoc (argument-specs a)
                       :positional true
                       :ref (argument-ref a optional))])))

(defn command-spec
  "Everything one command parses: its arguments and the options only it reads.
   The options legu itself takes are inherited from the dispatch level."
  [{:keys [options] :as command}]
  (merge (argument-spec command)
         (select-keys command-options options)))

(defn usage
  "legu's own help, generated from the table the parser reads. The first line
   is legu's own, because babashka.cli's help starts at Usage:."
  []
  (str "legu — human review coverage\n\n"
       (cli/format-command-help {:table commands :prog "legu" :spec options})))

(defn command-help
  "The help for one command. babashka.cli renders a command's own page from an
   entry that names no command, under a prog that does."
  [{:keys [cmds doc] :as command}]
  (cli/format-command-help {:table [{:cmds [] :doc doc
                                     :spec (command-spec command)}]
                            :prog (str/join " " (cons "legu" cmds))
                            :spec options}))

(defn group-help
  "The help for a group: its subcommands, listed as `legu --help` lists
   commands."
  [{:keys [cmds]}]
  (cli/format-command-help
   {:table (for [command commands
                 :when (and (= (inc (count cmds)) (count (:cmds command)))
                            (= cmds (pop (:cmds command))))]
             (update command :cmds (comp vector peek)))
    :prog (str/join " " (cons "legu" cmds))
    :spec options}))

(defn print-version [opts]
  (emit opts {:version VERSION :schema sidecar-schema}
        (fn [{:keys [version schema]}]
          (println (str "legu " version " (store schema " schema ")")))))

(defn dispatch-entry
  "A command's entry in the dispatch tree. --version and --help are answered
   here, in the order the parser they replace answered them: --version wins."
  [{:keys [cmds run arguments doc] :as command}]
  {:cmds cmds
   :doc doc
   :restrict true
   ;; babashka.cli stops reading options at the first argument no key claims,
   ;; so `legu mark <target> --reviewer NAME` reaches --reviewer only once
   ;; <target> has a key.
   :args->opts arguments
   :spec (command-spec command)
   ;; A word behind the terminator stays in :args, where no positional key
   ;; reaches it, so the arguments are filled and counted here rather than by
   ;; :require and :restrict-args. That is what keeps `legu status --
   ;; -weird.txt` a path rather than a surplus argument.
   :fn (fn [{:keys [opts args]}]
         (cond
           (:version opts) (print-version opts)
           (:help opts) (println (command-help command))
           :else (let [unfilled (remove #(contains? opts %) arguments)
                       opts (merge opts (zipmap unfilled args))]
                   (when-let [extra (nth args (count unfilled) nil)]
                     (die (str "unexpected argument: " extra)))
                   (when-let [message (or (missing-argument command opts)
                                          (refused-argument command opts))]
                     (die message))
                   (run {:opts opts}))))})

(defn group-entry
  "A group's entry in the dispatch tree. On its own, or with --help, it prints
   the subcommands; any other word after it is an unknown command."
  [{:keys [cmds doc] :as group}]
  {:cmds cmds
   :doc doc
   :restrict true
   :restrict-args true
   :fn (fn [{:keys [opts]}]
         (if (:version opts) (print-version opts) (println (group-help group))))})

(def dispatch-table
  (conj (mapv #(if (:run %) (dispatch-entry %) (group-entry %)) commands)
        {:cmds []
         :restrict true
         ;; Without this a word that names no command is read as one of legu's
         ;; own arguments and the run exits 0.
         :restrict-args true
         :fn (fn [{:keys [opts]}]
               (if (:version opts) (print-version opts) (println (usage))))}))

(def option-message
  "What legu says when an option's value is wrong. babashka.cli reports a
   missing value before it coerces one, so this cannot live in :validate alone.
   --order reads its values back out of the spec rather than repeating them:
   two lists of the orders that had to agree by hand is the drift this move
   set out to end."
  {:limit "--limit expects a positive integer"
   :order (str "--order expects one of "
               (str/join ", " (:enum (:order command-options))))
   :reviewer "--reviewer needs a value"})

(defn typed-flag
  "The token the reader typed for flag. babashka.cli splits a single-dash token
   into one-character flags, so the path -weird.txt is reported as -w."
  [flag argv]
  (-> (or (first (filter #(str/starts-with? % flag) argv)) flag)
      (str/split #"=" 2)
      first))

(defn refused-option
  "What legu says about an option a command will not take. An option legu has
   somewhere else is not unknown, and saying so sends the reader to the command
   that does take it rather than to the spelling of the flag."
  [typed dispatch]
  (if-let [owners (and (contains? command-options (keyword (str/replace typed #"^--" "")))
                       (seq (for [{:keys [cmds options]} commands
                                  :when (some #{(keyword (str/replace typed #"^--" ""))} options)]
                              (str/join " " cmds))))]
    (if (seq dispatch)
      (str (str/join " " dispatch) " does not take " typed)
      (str typed " belongs to " (str/join " and " owners)
           ", and stands after it"))
    (str "unknown option: " typed)))

(defn parse-error
  "legu's wording for a parse failure, so every one still reaches the reader
   through die, in legu's voice and in the same <target> and [<path>] the
   command's help prints."
  [argv]
  (fn [{:keys [cause msg option flag value dispatch]}]
    (die (or (when (#{:coerce :validate} cause)
               (or (option-message option)
                   (when-let [command (command-named dispatch)]
                     (when (some #{option} (:arguments command))
                       (refused-value option (:optional command) value)))))
             (case cause
               :restrict (refused-option (typed-flag flag argv) dispatch)
               ;; Only the root and the groups refuse surplus words, and in
               ;; both the word was meant as a command.
               :restrict-args (str "unknown command: "
                                   (str/join " " (concat dispatch [value])))
               msg)))))

(defn find-root
  "The git top level, else the nearest ancestor holding a .review/ store, else
   the working directory."
  []
  (or (git-toplevel)
      (loop [d (fs/absolutize (fs/cwd))]
        (cond
          (nil? d) (str (fs/cwd))
          (fs/directory? (fs/file (fs/file d) ".review")) (str d)
          :else (recur (fs/parent d))))))

(defn -main [& argv]
  (when-let [message (babashka-too-old (System/getProperty "babashka.version") MIN-BABASHKA)]
    (die message))
  (binding [*root* (find-root)
            *git?* (some? (git-toplevel))]
    (cli/dispatch dispatch-table argv
                  {:prog "legu" :spec options :error-fn (parse-error argv)})))

;; The CLI suite loads this file to call the version comparison directly: no
;; subprocess can reach it, since that would need a babashka installed at each
;; version being compared. Without the guard a load takes over the process and
;; runs the command line instead.
(when (= *file* (System/getProperty "babashka.file"))
  (apply -main *command-line-args*))
